---
import { ClientRouter } from 'astro:transitions';

interface Props { title?: string; description?: string; }
const { title = 'Kaushal Kumar — AI/ML & Systems Developer', description = 'Portfolio of Kaushal Kumar — Mathematics & Computing student, AI/ML engineer, systems builder, and tech mentor.' } = Astro.props;
const currentPath = Astro.url.pathname;
const links = [
  { href:'/', label:'Home' }, { href:'/about/', label:'About' }, { href:'/experience/', label:'Experience' },
  { href:'/projects/', label:'Projects' }, { href:'/media/', label:'Media' }, { href:'/contact/', label:'Contact' },
];
---
<!doctype html>
<html lang="en"><head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#07090E" /><meta name="description" content={description} />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={Astro.url} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><title>{title}</title><ClientRouter fallback="swap" />
</head><body>
  <div class="ambient" aria-hidden="true"></div><canvas id="global-canvas" transition:persist="global-canvas" aria-hidden="true"></canvas><div class="noise" aria-hidden="true"></div>
  <header class="site-header"><a class="brand" href="/" aria-label="Kaushal Kumar home"><span class="brand-mark">K</span><span>kaushal<span class="accent">.</span></span></a>
    <nav class="nav" aria-label="Primary navigation">{links.map((link)=><a class:active={currentPath===link.href || (link.href!=='/' && currentPath.startsWith(link.href))} href={link.href}>{link.label}</a>)}</nav>
    <button class="command-trigger" id="command-trigger" type="button" aria-label="Open command palette">⌘ K</button>
  </header>
  <main class="page-shell"><slot /></main>
  <footer class="site-footer"><span>© {new Date().getFullYear()} Kaushal Kumar</span><span class="status"><i></i> Open to research &amp; AI engineering collaborations</span><a href="https://github.com/ratwet" target="_blank" rel="noreferrer">GitHub ↗</a></footer>
  <dialog id="command-palette" class="command-palette" aria-label="Site navigation"><div class="palette-card"><div class="palette-top"><span>Command Center</span><kbd>ESC</kbd></div><input id="command-input" type="search" placeholder="Jump to a page..." autocomplete="off" /><div id="command-results" class="command-results">{links.map((link,index)=><a class="command-item" data-label={link.label.toLowerCase()} href={link.href}><span>0{index+1}</span>{link.label}</a>)}</div></div></dialog>
  <script>
    const canvas = document.querySelector('#global-canvas');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (canvas instanceof HTMLCanvasElement && !reduced.matches && canvas.dataset.running !== 'true') {
      canvas.dataset.running = 'true'; const ctx = canvas.getContext('2d');
      const dots = Array.from({length:34},()=>({x:Math.random(),y:Math.random(),vx:(Math.random()-.5)*.00022,vy:(Math.random()-.5)*.00022}));
      const resize=()=>{canvas.width=Math.floor(innerWidth*devicePixelRatio);canvas.height=Math.floor(innerHeight*devicePixelRatio);canvas.style.width=innerWidth+'px';canvas.style.height=innerHeight+'px';ctx?.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0)};
      const frame=()=>{if(!ctx)return;ctx.clearRect(0,0,innerWidth,innerHeight);const g=ctx.createRadialGradient(innerWidth*.55,innerHeight*.35,0,innerWidth*.55,innerHeight*.35,Math.max(innerWidth,innerHeight)*.7);g.addColorStop(0,'rgba(0,242,254,.065)');g.addColorStop(1,'rgba(7,9,14,0)');ctx.fillStyle=g;ctx.fillRect(0,0,innerWidth,innerHeight);dots.forEach(p=>{p.x+=p.vx*16;p.y+=p.vy*16;if(p.x<0||p.x>1)p.vx*=-1;if(p.y<0||p.y>1)p.vy*=-1});for(let i=0;i<dots.length;i++)for(let j=i+1;j<dots.length;j++){const a=dots[i],b=dots[j],dx=(a.x-b.x)*innerWidth,dy=(a.y-b.y)*innerHeight,d=Math.hypot(dx,dy);if(d<170){ctx.strokeStyle=`rgba(0,242,254,${(1-d/170)*.11})`;ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(a.x*innerWidth,a.y*innerHeight);ctx.lineTo(b.x*innerWidth,b.y*innerHeight);ctx.stroke()}}dots.forEach(p=>{ctx.fillStyle='rgba(56,189,248,.32)';ctx.beginPath();ctx.arc(p.x*innerWidth,p.y*innerHeight,1.4,0,Math.PI*2);ctx.fill()});requestAnimationFrame(frame)};
      addEventListener('resize',resize);resize();frame();
    }
    if (!document.documentElement.dataset.commandReady) {
      document.documentElement.dataset.commandReady='true'; const dialog=document.querySelector('#command-palette'); const trigger=document.querySelector('#command-trigger'); const input=document.querySelector('#command-input'); const items=[...document.querySelectorAll('.command-item')];
      const openPalette=()=>{if(dialog instanceof HTMLDialogElement){dialog.showModal();input?.focus()}}; trigger?.addEventListener('click',openPalette); addEventListener('keydown',e=>{if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();openPalette()}}); input?.addEventListener('input',()=>{const q=input.value.trim().toLowerCase();items.forEach(item=>{if(item instanceof HTMLElement)item.hidden=!item.dataset.label?.includes(q)})}); dialog?.addEventListener('click',e=>{if(e.target===dialog&&dialog instanceof HTMLDialogElement)dialog.close()});
    }
  </script>
</body></html>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap');
:root{--bg:#07090e;--line:rgba(255,255,255,.08);--cyan:#00f2fe;--blue:#38bdf8;--mint:#10b981;--text:#f8fafc;--muted:#94a3b8}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,sans-serif;min-height:100vh;overflow-x:hidden}a{color:inherit;text-decoration:none}.ambient{position:fixed;inset:0;background:radial-gradient(circle at 70% 15%,rgba(0,242,254,.06),transparent 28%),radial-gradient(circle at 20% 75%,rgba(16,185,129,.04),transparent 28%);pointer-events:none;z-index:-3}.noise{position:fixed;inset:0;opacity:.025;pointer-events:none;z-index:-1;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.35'/%3E%3C/svg%3E")}#global-canvas{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:-2}.site-header{position:sticky;top:16px;z-index:20;margin:16px auto 0;width:min(1180px,calc(100% - 28px));display:flex;align-items:center;gap:20px;padding:10px 12px;border:1px solid var(--line);background:rgba(7,9,14,.78);backdrop-filter:blur(18px);border-radius:18px;box-shadow:0 20px 70px rgba(0,0,0,.26)}.brand{display:flex;align-items:center;gap:9px;font-weight:700;letter-spacing:-.03em}.brand-mark{display:grid;place-items:center;width:30px;height:30px;border:1px solid rgba(56,189,248,.34);border-radius:9px;background:rgba(56,189,248,.08);font-family:'JetBrains Mono';font-size:13px}.accent{color:var(--cyan)}.nav{display:flex;gap:4px;margin-left:auto}.nav a{padding:8px 11px;border-radius:10px;color:var(--muted);font-size:13px}.nav a:hover,.nav a.active{color:var(--text);background:rgba(255,255,255,.06)}.command-trigger,.palette-top kbd{font:500 12px 'JetBrains Mono';color:var(--muted);border:1px solid var(--line);background:rgba(255,255,255,.04);border-radius:9px;padding:8px 10px}.command-trigger{cursor:pointer}.page-shell{width:min(1180px,calc(100% - 28px));margin:0 auto;padding:76px 0 90px}.site-footer{width:min(1180px,calc(100% - 28px));margin:0 auto;padding:24px 0 36px;color:var(--muted);font:12px 'JetBrains Mono';display:flex;justify-content:space-between;gap:18px;border-top:1px solid var(--line)}.status{display:flex;align-items:center;gap:8px}.status i{width:7px;height:7px;border-radius:50%;background:var(--mint);box-shadow:0 0 15px var(--mint)}.command-palette{width:min(620px,calc(100% - 30px));padding:0;border:0;background:transparent}.command-palette::backdrop{background:rgba(0,0,0,.62);backdrop-filter:blur(5px)}.palette-card{padding:14px;border:1px solid var(--line);border-radius:18px;background:rgba(10,14,23,.94);box-shadow:0 30px 100px rgba(0,0,0,.5)}.palette-top{display:flex;justify-content:space-between;align-items:center;padding:4px 4px 12px;color:var(--muted);font:12px 'JetBrains Mono'}.command-palette input{width:100%;padding:15px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.04);color:var(--text);font:14px Inter;outline:none}.command-palette input:focus{border-color:rgba(0,242,254,.42)}.command-results{display:grid;gap:5px;margin-top:10px;max-height:360px;overflow:auto}.command-item{display:flex;gap:14px;align-items:center;padding:13px;border-radius:10px;color:var(--muted)}.command-item span{font:11px 'JetBrains Mono';color:var(--blue)}.command-item:hover{color:var(--text);background:rgba(255,255,255,.05)}.command-item[hidden]{display:none}@media(max-width:760px){.nav a:nth-child(n+4){display:none}.site-header{top:8px;margin-top:8px}.page-shell{padding-top:52px}.site-footer{flex-wrap:wrap}.site-footer .status{order:3;width:100%}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.ambient{background:radial-gradient(circle at 70% 15%,rgba(0,242,254,.045),transparent 28%)}}
</style>
