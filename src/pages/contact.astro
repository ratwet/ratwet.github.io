---
import Layout from '../layouts/Layout.astro';
const channels = [
  { label: 'Email', value: 'kaushalkumar@duck.com', href: 'mailto:kaushalkumar@duck.com', note: 'Best for opportunities and collaborations' },
  { label: 'GitHub', value: 'github.com/ratwet', href: 'https://github.com/ratwet', note: 'Code, experiments, and public work' },
  { label: 'LinkedIn', value: 'linkedin.com/in/kaushal-kumar-072739206', href: 'https://linkedin.com/in/kaushal-kumar-072739206', note: 'Professional profile and networking' },
];
---
<Layout title="Contact | Kaushal Kumar" description="Contact Kaushal Kumar for internships, research opportunities, collaborations, and technical conversations.">
  <header class="page-heading"><p class="eyebrow">Contact</p><h1>Let’s talk about useful work.</h1><p>I am currently interested in internships, engineering teams, research opportunities, and collaborations where building something is part of the conversation.</p></header>
  <section class="contact-layout">
    <div class="contact-primary"><span class="label">Email</span><a class="email" href="mailto:kaushalkumar@duck.com">kaushalkumar@duck.com</a><p>Best place to start. A short description of the opportunity or technical problem is enough.</p></div>
    <div class="contact-links">{channels.slice(1).map((channel) => <a class="contact-link" href={channel.href} target="_blank" rel="noopener noreferrer"><span class="label">{channel.label}</span><strong>{channel.value}</strong><small>{channel.note}</small><b>↗</b></a>)}</div>
  </section>
  <section class="availability"><div><span class="label">Current status</span><h2>Open to selected opportunities.</h2></div><p>Priority areas: software engineering, applied AI and ML, research, computer vision, embedded systems, and robotics.</p></section>
</Layout>
<style>
.page-heading{max-width:820px;padding:45px 0 70px}.eyebrow{margin:0 0 14px;color:var(--color-signal);font:12px var(--font-mono)}.page-heading h1{max-width:760px;margin:0;font-size:var(--step-5);line-height:1;letter-spacing:-.055em}.page-heading>p:last-child{max-width:700px;margin:23px 0 0;color:var(--color-ink-dim);font-size:17px;line-height:1.75}.contact-layout{display:grid;grid-template-columns:1.15fr .85fr;gap:45px;border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border)}.contact-primary{padding:28px 0 34px}.label{display:block;color:var(--color-ink-faint);font:10px var(--font-mono)}.email{display:block;margin-top:12px;color:var(--color-signal);font-size:clamp(22px,3vw,34px);font-weight:500;letter-spacing:-.03em}.contact-primary p{max-width:560px;margin:13px 0 0;color:var(--color-ink-dim);font-size:13px;line-height:1.7}.contact-links{border-left:1px solid var(--color-border)}.contact-link{position:relative;display:block;padding:22px 0 22px 24px;border-bottom:1px solid var(--color-border)}.contact-link:last-child{border-bottom:0}.contact-link strong{display:block;margin-top:7px;padding-right:25px;color:var(--color-ink);font-size:14px;font-weight:500;word-break:break-word}.contact-link small{display:block;margin-top:5px;color:var(--color-ink-dim);font-size:11px}.contact-link b{position:absolute;right:0;top:25px;color:var(--color-signal);font-weight:400}.contact-link:hover strong{color:var(--color-signal)}.availability{display:grid;grid-template-columns:1fr 1fr;gap:40px;padding:28px 0;margin-top:55px;border-top:1px solid var(--color-border)}.availability h2{margin:7px 0 0;font-size:var(--step-2);letter-spacing:-.03em}.availability p{max-width:520px;margin:0;color:var(--color-ink-dim);font-size:13px;line-height:1.7}@media(max-width:760px){.contact-layout,.availability{grid-template-columns:1fr}.contact-links{border-left:0;border-top:1px solid var(--color-border)}.contact-link{padding-left:0}.page-heading{padding-top:28px}}
</style>
