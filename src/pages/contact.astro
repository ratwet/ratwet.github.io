---
import Layout from '../layouts/Layout.astro';
const channels = [
  {label:'Email', value:'kaushalkumar@duck.com', href:'mailto:kaushalkumar@duck.com'},
  {label:'GitHub', value:'github.com/ratwet', href:'https://github.com/ratwet'},
  {label:'LinkedIn', value:'linkedin.com/in/kaushal-kumar-072739206', href:'https://linkedin.com/in/kaushal-kumar-072739206'},
  {label:'Location', value:'Delhi, India', href:'#'},
];
---
<Layout title="Contact — Kaushal Kumar"><div class="page-intro"><span class="mono">05 / contact</span><h1>Open a channel.</h1><p>For research collaborations, engineering opportunities, mentorship, or a good technical problem, reach out directly.</p></div><section class="contact-grid"><div class="terminal panel"><div class="terminal-head"><i></i><i></i><i></i><span>kaushal@portfolio:~</span></div><div class="terminal-body"><p><span class="prompt">$</span> whoami</p><h2>Kaushal Kumar</h2><p class="dim">Mathematics &amp; Computing · AI/ML · Systems · Robotics</p><p><span class="prompt">$</span> status</p><p class="green">Available for selected collaborations.</p><p><span class="prompt">$</span> connect --email</p><a class="email" href="mailto:kaushalkumar@duck.com">kaushalkumar@duck.com</a><p><span class="prompt">$</span> _</p></div></div><div class="channels">{channels.map(c=><a class="channel panel" href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel={c.href.startsWith('http') ? 'noreferrer' : undefined}><span>{c.label}</span><strong>{c.value}</strong><b>↗</b></a>)}</div></section></Layout>
<style>
.page-intro{max-width:780px;padding:40px 0 62px}.mono{font:12px 'JetBrains Mono';color:#38bdf8}.page-intro h1{font-size:clamp(42px,6vw,70px);line-height:1;letter-spacing:-.055em;margin:14px 0}.page-intro p{color:#93a1b5;line-height:1.75}.contact-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:14px}.panel{border:1px solid var(--line);background:rgba(15,23,42,.54);border-radius:16px}.terminal{overflow:hidden;background:#080b11}.terminal-head{display:flex;align-items:center;gap:6px;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,.06);font:10px 'JetBrains Mono';color:#65748b}.terminal-head i{width:7px;height:7px;border-radius:50%;background:#263244}.terminal-head span{margin-left:5px}.terminal-body{padding:22px;font:12px/1.8 'JetBrains Mono';color:#cbd5e1;min-height:330px}.terminal-body p{margin:0 0 7px}.terminal-body h2{font:700 20px Inter;margin:0 0 3px}.prompt{color:#22d3ee}.dim{color:#64748b}.green{color:#6ee7b7}.email{color:#d8f9ff}.channels{display:grid;gap:10px}.channel{padding:18px;display:grid;grid-template-columns:1fr auto;gap:6px 12px;transition:transform .2s,border-color .2s}.channel:hover{transform:translateX(3px);border-color:rgba(56,189,248,.22)}.channel span{grid-column:1/-1;font:10px 'JetBrains Mono';color:#38bdf8}.channel strong{font-size:14px;color:#d7deea;word-break:break-word}.channel b{color:#38bdf8}@media(max-width:820px){.contact-grid{grid-template-columns:1fr}}
</style>
