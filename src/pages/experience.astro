---
import Layout from '../layouts/Layout.astro';
const experiences = [
  { period:'Sep 2026 to Present', role:'Tech Mentor', org:'Central University of Jammu · e-Yantra', kind:'Leadership & Mentorship', points:['Mentoring student technical teams across robotics, embedded systems, algorithms, and competitive software challenges.','Guiding hands-on build pipelines around ESP32, wireless telemetry, and real-time sensor processing.'], skills:['Robotics','Embedded Systems','Technical Mentorship','C++','ESP32'], metric:'10+ teams mentored' },
  { period:'June 2026 to July 2026', role:'Summer Intern · AI & ML', org:'ShadowFox · Remote', kind:'AI / ML Engineering', points:['Engineered a custom CNN from scratch on CIFAR-10 and reached 74.07% test accuracy over 25 epochs with Tesla T4 acceleration.','Analyzed 8,399 retail orders with Python, Pandas, and Plotly to identify segment-level margin and absolute-profit peaks.','Evaluated Gemma 2 (2.61B parameters, 26 layers), visualized Layer 13 attention, and benchmarked against GPT-2 (124M).'], skills:['PyTorch','TensorFlow','CNN','Gemma 2','Plotly','Attention Maps'], metric:'74.07% CNN test accuracy' },
];
---
<Layout title="Experience | Kaushal Kumar">
  <div class="page-intro"><span class="mono">02 / EXPERIENCE</span><h1>Experience built through ownership and iteration.</h1><p>A compact timeline of mentorship and applied AI work, with outcomes and technical scope kept visible.</p></div>
  <section class="timeline">{experiences.map((e,index)=><article class="entry"><div class="rail"><span>{String(index+1).padStart(2,'0')}</span></div><div class="body"><div class="top"><span class="mono">{e.period}</span><span class="kind">{e.kind}</span></div><h2>{e.role}</h2><h3>{e.org}</h3><div class="rule"></div><div class="work-content"><div><span class="label">SCOPE</span><ul>{e.points.map(p=><li>{p}</li>)}</ul></div><div class="impact"><span class="label">SIGNAL</span><strong>{e.metric}</strong></div></div><div class="bottom"><span class="label">TOOLS &amp; DOMAINS</span><div class="skills">{e.skills.map(s=><span>{s}</span>)}</div></div></div></article>)}</section>
</Layout>
<style>
.page-intro{max-width:880px;padding:38px 0 64px}.mono,.label{font:10px 'JetBrains Mono';color:var(--blue);letter-spacing:.07em}.page-intro h1{font-size:clamp(45px,6.5vw,76px);line-height:.98;letter-spacing:-.06em;margin:13px 0}.page-intro p{max-width:730px;color:#96a2b3;font-size:14px;line-height:1.8}.timeline{position:relative;max-width:1040px}.timeline:before{content:'';position:absolute;left:21px;top:24px;bottom:24px;width:1px;background:linear-gradient(var(--blue),rgba(88,182,255,.05))}.entry{display:grid;grid-template-columns:48px 1fr;gap:18px;margin-bottom:12px}.rail{position:relative}.rail span{position:relative;z-index:1;display:grid;place-items:center;width:43px;height:43px;border:1px solid rgba(88,182,255,.2);border-radius:12px;background:#0a0e15;color:#67c7f7;font:9px 'JetBrains Mono'}.body{border:1px solid var(--line);background:var(--panel);backdrop-filter:blur(14px);border-radius:17px;padding:21px}.top{display:flex;justify-content:space-between;align-items:center;gap:20px}.kind{padding:5px 7px;border:1px solid rgba(94,230,178,.15);border-radius:7px;background:rgba(94,230,178,.03);color:#78dab8;font:9px 'JetBrains Mono'}.body h2{margin:16px 0 4px;font-size:27px;letter-spacing:-.04em}.body h3{margin:0;color:#bbc6d4;font-size:13px;font-weight:500}.rule{height:1px;background:var(--line);margin:20px 0}.work-content{display:grid;grid-template-columns:1fr 220px;gap:35px}.label{display:block;color:#56667b;font-size:9px}.body ul{margin:10px 0 0;padding-left:18px;color:#8d9bad;font-size:12px;line-height:1.8}.impact{padding:14px;border:1px solid rgba(255,255,255,.06);border-radius:11px;background:#090d13;display:flex;flex-direction:column;justify-content:space-between}.impact strong{margin-top:14px;color:#d2f7fa;font:600 15px 'JetBrains Mono';line-height:1.35}.bottom{display:flex;align-items:center;gap:20px;margin-top:21px;padding-top:17px;border-top:1px solid var(--line)}.bottom>.label{min-width:104px}.skills{display:flex;gap:6px;flex-wrap:wrap}.skills span{padding:5px 7px;border:1px solid rgba(255,255,255,.06);border-radius:7px;color:#758398;font:8px 'JetBrains Mono'}@media(max-width:780px){.work-content{grid-template-columns:1fr}.top,.bottom{align-items:flex-start;flex-direction:column}.bottom{gap:10px}.entry{grid-template-columns:40px 1fr}.rail span{width:35px;height:35px}.timeline:before{left:17px}}
</style>
