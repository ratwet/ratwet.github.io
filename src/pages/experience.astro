---
import Layout from '../layouts/Layout.astro';
const experiences = [
  { period:'Sep 2026 — Present', role:'Tech Mentor', org:'Central University of Jammu · e-Yantra', kind:'Leadership & Mentorship', points:['Mentoring student technical teams in robotics, embedded systems, algorithms, and competitive software challenges.','Guiding hands-on build pipelines around ESP32, wireless telemetry, and real-time sensor processing.'], skills:['Robotics','Embedded Systems','Technical Mentorship','C++','ESP32'], metric:'10+ teams mentored' },
  { period:'June 2026 — July 2026', role:'Summer Intern · AI & ML', org:'ShadowFox · Remote', kind:'AI / ML Research', points:['Engineered a custom CNN from scratch on CIFAR-10; reached 74.07% test accuracy over 25 epochs with Tesla T4 acceleration.','Analyzed 8,399 retail orders with Python, Pandas, and Plotly; identified segment-level margin and absolute-profit peaks.','Evaluated Gemma 2 (2.61B parameters, 26 layers), visualized Layer 13 attention, and benchmarked against GPT-2 (124M).'], skills:['PyTorch','TensorFlow','CNN','Gemma 2','Plotly','Attention Maps'], metric:'74.07% CNN test accuracy' },
];
---
<Layout title="Experience — Kaushal Kumar">
  <div class="page-intro"><span class="mono">02 / experience</span><h1>Where I turn experiments into systems.</h1><p>An engineering timeline centered on mentorship, computer vision, analytics, and LLM evaluation.</p></div>
  <section class="timeline">{experiences.map((e)=><article class="entry"><div class="rail"><span></span></div><div class="body"><div class="top"><span class="mono">{e.period}</span><span class="kind">{e.kind}</span></div><h2>{e.role}</h2><h3>{e.org}</h3><ul>{e.points.map(p=><li>{p}</li>)}</ul><div class="bottom"><div class="skills">{e.skills.map(s=><span>{s}</span>)}</div><strong>{e.metric}</strong></div></div></article>)}</section>
</Layout>
<style>
.page-intro{max-width:800px;padding:40px 0 72px}.mono{font:12px 'JetBrains Mono';color:#38bdf8}.page-intro h1{font-size:clamp(42px,6vw,70px);line-height:1;letter-spacing:-.055em;margin:14px 0}.page-intro p{color:#93a1b5;line-height:1.75}.timeline{position:relative;max-width:930px}.timeline:before{content:'';position:absolute;left:8px;top:15px;bottom:15px;width:1px;background:linear-gradient(#38bdf8,rgba(56,189,248,.08))}.entry{display:grid;grid-template-columns:30px 1fr;gap:18px;margin-bottom:20px}.rail{position:relative}.rail span{position:absolute;top:14px;left:3px;width:11px;height:11px;border-radius:50%;background:#07090e;border:2px solid #38bdf8;box-shadow:0 0 16px rgba(56,189,248,.3)}.body{border:1px solid var(--line);background:rgba(15,23,42,.54);border-radius:16px;padding:22px}.top,.bottom{display:flex;justify-content:space-between;gap:16px;align-items:center}.kind{font:10px 'JetBrains Mono';color:#6ee7b7;border:1px solid rgba(16,185,129,.16);padding:5px 7px;border-radius:7px}.body h2{margin:16px 0 4px;font-size:26px;letter-spacing:-.035em}.body h3{margin:0;color:#b4c0d0;font-size:14px;font-weight:500}.body ul{margin:20px 0;padding-left:18px;color:#8f9eb2;line-height:1.75;font-size:14px}.skills{display:flex;gap:7px;flex-wrap:wrap}.skills span{font:10px 'JetBrains Mono';color:#7f8ea4;padding:5px 7px;border:1px solid rgba(255,255,255,.07);border-radius:7px}.bottom strong{font:12px 'JetBrains Mono';color:#c7f9ff}@media(max-width:700px){.top,.bottom{align-items:flex-start;flex-direction:column}.entry{grid-template-columns:22px 1fr}.timeline:before{left:5px}.rail span{left:0}}
</style>
