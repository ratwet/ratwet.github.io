---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const experiences = (await getCollection('experience')).sort((a, b) => b.data.start.localeCompare(a.data.start));
---
<Layout title="Experience | Kaushal Kumar" description="Experience in technical mentorship and applied AI and machine learning work.">
  <header class="page-heading"><p class="eyebrow">Experience</p><h1>Work that has taught me how systems behave.</h1><p>A concise record of technical mentorship and applied AI work. I keep the description close to what I actually built and learned.</p></header>
  <section class="experience-list">
    {experiences.map((entry, index) => <article class="experience-item">
      <div class="experience-index">{String(index + 1).padStart(2, '0')}</div>
      <div class="experience-main">
        <div class="experience-meta"><span>{entry.data.start}{entry.data.end ? ` to ${entry.data.end}` : ' to present'}</span><span>{entry.data.location ?? ''}</span></div>
        <h2>{entry.data.role}</h2><p class="org">{entry.data.org}</p>
        <ul>{entry.data.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
        <div class="entry-note"><span>What I worked on</span><strong>{entry.body ? 'Detailed notes available in the source entry' : 'Applied technical work'}</strong></div>
      </div>
    </article>)}
  </section>
</Layout>
<style>
.page-heading{max-width:820px;padding:45px 0 70px}.eyebrow{margin:0 0 14px;color:var(--color-signal);font:12px var(--font-mono)}.page-heading h1{max-width:760px;margin:0;font-size:var(--step-5);line-height:1;letter-spacing:-.055em}.page-heading>p:last-child{max-width:700px;margin:23px 0 0;color:var(--color-ink-dim);font-size:17px;line-height:1.75}.experience-list{border-top:1px solid var(--color-border)}.experience-item{display:grid;grid-template-columns:56px 1fr;gap:24px;padding:28px 0;border-bottom:1px solid var(--color-border)}.experience-index{color:var(--color-signal);font:11px var(--font-mono);padding-top:3px}.experience-meta{display:flex;justify-content:space-between;gap:20px;color:var(--color-ink-faint);font:10px var(--font-mono)}.experience-main h2{margin:10px 0 2px;font-size:27px;letter-spacing:-.04em}.org{margin:0;color:var(--color-ink-dim);font-size:14px}.experience-main ul{max-width:760px;margin:22px 0 0;padding-left:19px;color:var(--color-ink-dim);font-size:14px;line-height:1.8}.entry-note{display:flex;justify-content:space-between;gap:20px;margin-top:21px;padding-top:15px;border-top:1px solid var(--color-border);color:var(--color-ink-faint);font:10px var(--font-mono)}.entry-note strong{color:var(--color-ink-dim);font-weight:500}@media(max-width:650px){.experience-item{grid-template-columns:32px 1fr;gap:12px}.experience-meta,.entry-note{align-items:flex-start;flex-direction:column;gap:7px}.page-heading{padding-top:28px}}
</style>
