---
import Layout from '../layouts/Layout.astro';
const education = [
  { institution:'Central University of Jammu', degree:'B.Tech', field:'Mathematics & Computing', period:'2025 — 2029', status:'In Progress', courses:'Linear Algebra · Discrete Mathematics · Data Structures & Algorithms · Computer Organization · Probability & Stochastic Processes' },
  { institution:'School of Excellence Madanpur Khadar', degree:'Senior Secondary', field:'Science Stream (PCM)', period:'Completed', status:'80%', courses:'' },
];
const certs = [
  { title:'Prompt Engineering for ChatGPT', issuer:'Coursera', date:'May 2026', id:'OAZ4B1SJF9JW', url:'https://coursera.org/verify/OAZ4B1SJF9JW' },
  { title:'Introduction to Artificial Intelligence', issuer:'Coursera', date:'March 2026', id:'DTZBNFPSJR97', url:'https://coursera.org/verify/DTZBNFPSJR97' },
];
const seminars = [
  { title:'AI Builders Weekend', organizer:"Masters' Union", location:'New Delhi', body:'Workshop on building AI agents from scratch using Python, including autonomous agent architecture, tool calling, and ReAct mechanics.' },
  { title:'National Seminar on AI for Good Governance', organizer:'Dr. Ambedkar International Centre', location:'New Delhi', body:'National deliberations covering India AI Mission, Project Tapestry, Distributed AI, DSS Studio, sovereignty, ethics, and governance.' },
];
---
<Layout title="About — Kaushal Kumar">
  <div class="page-intro"><span class="mono">01 / identity</span><h1>Builder. Mentor. Systems thinker.</h1><p>I’m Kaushal Kumar, a Mathematics &amp; Computing student focused on practical AI/ML, edge systems, computer vision, robotics, and technical mentorship.</p></div>
  <section class="section"><div class="kicker">EDUCATION</div><div class="stack">{education.map((e)=><article class="card"><div class="marker">●</div><div><div class="meta">{e.period} · {e.status}</div><h2>{e.institution}</h2><h3>{e.degree} · {e.field}</h3>{e.courses && <p>{e.courses}</p>}</div></article>)}</div></section>
  <section class="section"><div class="kicker">CERTIFICATIONS</div><div class="grid">{certs.map((c)=><article class="card"><span class="tag">{c.issuer}</span><h2>{c.title}</h2><p>{c.date}</p><code>{c.id}</code><a class="text-link" href={c.url} target="_blank" rel="noreferrer">Verify credential ↗</a></article>)}</div></section>
  <section class="section"><div class="kicker">SEMINARS &amp; WORKSHOPS</div><div class="grid">{seminars.map((s)=><article class="card"><span class="tag mint">{s.location}</span><h2>{s.title}</h2><p class="meta">{s.organizer}</p><p>{s.body}</p></article>)}</div></section>
</Layout>
<style>
.page-intro{max-width:780px;padding:40px 0 70px}.mono,.meta{font:12px 'JetBrains Mono';color:#38bdf8}.page-intro h1{font-size:clamp(42px,6vw,70px);line-height:1;letter-spacing:-.055em;margin:14px 0}.page-intro p,.card p{color:#93a1b5;line-height:1.75}.section{margin:0 0 70px}.kicker{font:11px 'JetBrains Mono';color:#687790;margin-bottom:15px;letter-spacing:.08em}.stack{display:grid;gap:12px}.card{border:1px solid var(--line);background:rgba(15,23,42,.54);border-radius:16px;padding:20px;position:relative}.stack .card{display:grid;grid-template-columns:20px 1fr;gap:14px}.marker{color:#10b981;padding-top:4px}.card h2{margin:11px 0 5px;font-size:22px;letter-spacing:-.025em}.card h3{margin:0;color:#cbd5e1;font-size:13px;font-weight:500}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.tag{display:inline-block;padding:5px 7px;border:1px solid rgba(56,189,248,.18);border-radius:7px;background:rgba(56,189,248,.05);color:#7dd3fc;font:10px 'JetBrains Mono'}.tag.mint{color:#6ee7b7;border-color:rgba(16,185,129,.18);background:rgba(16,185,129,.05)}code{display:block;margin:16px 0;padding:10px;background:#080b11;border:1px solid var(--line);border-radius:8px;color:#a5b4fc;font:11px 'JetBrains Mono'}.text-link{font-size:12px;color:#d8f9ff}@media(max-width:700px){.grid{grid-template-columns:1fr}}
</style>
