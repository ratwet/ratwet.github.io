---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const certs = await getCollection('certifications');
const education = [
  { institution: 'Central University of Jammu', degree: 'B.Tech', field: 'Mathematics & Computing', period: '2025 to 2029', status: 'In progress', courses: 'Linear Algebra · Discrete Mathematics · Data Structures & Algorithms · Computer Organization · Probability & Stochastic Processes' },
  { institution: 'School of Excellence Madanpur Khadar', degree: 'Senior Secondary', field: 'Science Stream (PCM)', period: 'Completed', status: '80%', courses: '' },
];
const seminars = [
  { title: 'AI Builders Weekend', organizer: "Masters' Union", location: 'New Delhi', body: 'Workshop on building AI agents from scratch using Python, including autonomous agent architecture, tool calling, and ReAct mechanics.', asset: '/assets/media/ai-builders-weekend.jpg' },
  { title: 'National Seminar on AI for Good Governance', organizer: 'Dr. Ambedkar International Centre', location: 'New Delhi', body: 'National seminar covering the India AI Mission, distributed AI, governance, sovereignty, ethics, and public-sector applications.', asset: '/assets/media/ai-governance-seminar.jpg' },
];
---
<Layout title="About | Kaushal Kumar" description="About Kaushal Kumar, a Mathematics & Computing student focused on applied AI, computer vision, embedded systems, robotics, and technical mentorship.">
  <header class="page-heading">
    <p class="eyebrow">About</p>
    <h1>A technical foundation, still being built.</h1>
    <p>I am Kaushal Kumar, a Mathematics &amp; Computing student at Central University of Jammu. I learn by building practical systems, studying the constraints around them, and explaining what I learn clearly.</p>
  </header>

  <section class="focus-band" aria-labelledby="focus-title">
    <div><span class="label">Current focus</span><h2 id="focus-title">Applied AI with a systems mindset.</h2></div>
    <ul class="focus-list"><li>Computer Vision</li><li>Machine Learning</li><li>Embedded Systems</li><li>Robotics</li><li>Python / C++</li><li>Technical Mentorship</li></ul>
  </section>

  <section class="section-block" aria-labelledby="education-title">
    <div class="section-heading"><div><span class="label">Education</span><h2 id="education-title">Foundation</h2></div></div>
    <div class="timeline">
      {education.map((item) => <article class="timeline-item"><div class="timeline-marker"></div><div><p class="meta">{item.period} · {item.status}</p><h3>{item.institution}</h3><p class="degree">{item.degree} · {item.field}</p>{item.courses && <p class="body-copy">{item.courses}</p>}</div></article>)}
    </div>
  </section>

  <section class="section-block" aria-labelledby="credential-title">
    <div class="section-heading"><div><span class="label">Credentials</span><h2 id="credential-title">Learning beyond coursework.</h2></div></div>
    <div class="credential-list">{certs.map((cert) => <article class="credential"><div><p class="meta">{cert.data.issuer} · {cert.data.date}</p><h3>{cert.data.name}</h3></div><div class="credential-actions">{cert.data.credentialId && <code>{cert.data.credentialId}</code>}{cert.data.verifyUrl && <a href={cert.data.verifyUrl} target="_blank" rel="noopener noreferrer">Verify ↗</a>}</div></article>)}</div>
  </section>

  <section class="section-block" aria-labelledby="seminar-title">
    <div class="section-heading"><div><span class="label">Seminars and workshops</span><h2 id="seminar-title">Curiosity outside the syllabus.</h2></div></div>
    <div class="seminar-grid">{seminars.map((item) => <article class="seminar"><div class="photo-slot" aria-label={item.title}><span>Photo</span><small>{item.asset}</small></div><div class="seminar-copy"><p class="meta">{item.organizer} · {item.location}</p><h3>{item.title}</h3><p class="body-copy">{item.body}</p></div></article>)}</div>
  </section>
</Layout>
<style>
.page-heading{max-width:780px;padding:45px 0 70px}.eyebrow,.label,.meta{font-family:var(--font-mono)}.eyebrow{margin:0 0 14px;color:var(--color-signal);font-size:12px}.page-heading h1{max-width:760px;margin:0;font-size:var(--step-5);line-height:1;letter-spacing:-.055em}.page-heading>p:last-child{max-width:680px;margin:24px 0 0;color:var(--color-ink-dim);font-size:17px;line-height:1.75}.focus-band{display:grid;grid-template-columns:.85fr 1.15fr;gap:35px;padding:22px 0;border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border)}.label{color:var(--color-ink-faint);font-size:11px}.focus-band h2{margin:7px 0 0;font-size:var(--step-2);letter-spacing:-.03em}.focus-list{display:grid;grid-template-columns:1fr 1fr;margin:0;padding:0;list-style:none;border-left:1px solid var(--color-border)}.focus-list li{padding:8px 13px;color:var(--color-ink-dim);font-size:13px}.focus-list li:nth-child(odd){border-right:1px solid var(--color-border)}.section-block{padding-top:90px}.section-heading{margin-bottom:18px}.section-heading h2{margin:6px 0 0;font-size:var(--step-3);letter-spacing:-.04em}.timeline{border-top:1px solid var(--color-border)}.timeline-item{display:grid;grid-template-columns:34px 1fr;gap:18px;padding:24px 0;border-bottom:1px solid var(--color-border)}.timeline-marker{width:10px;height:10px;margin-top:6px;border:2px solid var(--color-signal);border-radius:50%}.meta{margin:0;color:var(--color-ink-faint);font-size:10px;line-height:1.5}.timeline-item h3{margin:8px 0 3px;font-size:20px;letter-spacing:-.025em}.degree{margin:0;color:var(--color-ink-dim);font-size:13px}.body-copy{max-width:72ch;margin:12px 0 0;color:var(--color-ink-dim);font-size:13px;line-height:1.7}.credential-list{border-top:1px solid var(--color-border)}.credential{display:flex;justify-content:space-between;gap:20px;align-items:center;padding:21px 0;border-bottom:1px solid var(--color-border)}.credential h3{margin:7px 0 0;font-size:18px}.credential-actions{display:flex;align-items:center;gap:12px}.credential code{padding:5px 7px;color:var(--color-ink-faint);background:var(--color-bg);border:1px solid var(--color-border);border-radius:var(--radius-md);font:9px var(--font-mono)}.credential-actions a{color:var(--color-signal);font:11px var(--font-mono)}.seminar-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}.seminar{border-top:1px solid var(--color-border)}.photo-slot{height:210px;display:flex;flex-direction:column;align-items:flex-end;justify-content:space-between;padding:13px;background:repeating-linear-gradient(135deg,var(--color-surface),var(--color-surface) 10px,var(--color-bg) 10px,var(--color-bg) 11px);border:1px solid var(--color-border);border-top:0;color:var(--color-ink-faint)}.photo-slot span{font:10px var(--font-mono)}.photo-slot small{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font:8px var(--font-mono)}.seminar-copy{padding-top:15px}.seminar-copy h3{margin:7px 0 0;font-size:20px;letter-spacing:-.025em}@media(max-width:760px){.focus-band,.seminar-grid{grid-template-columns:1fr}.focus-list{border-left:0;border-top:1px solid var(--color-border);padding-top:8px}.focus-list li:nth-child(odd){border-right:0}.credential{align-items:flex-start;flex-direction:column}.page-heading{padding-top:28px}.page-heading>p:last-child{font-size:16px}}
</style>
