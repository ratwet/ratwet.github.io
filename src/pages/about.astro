---
import Layout from '../layouts/Layout.astro';
const education = [
  { institution:'Central University of Jammu', degree:'B.Tech', field:'Mathematics & Computing', period:'2025 to 2029', status:'In progress', courses:'Linear Algebra · Discrete Mathematics · Data Structures & Algorithms · Computer Organization · Probability & Stochastic Processes' },
  { institution:'School of Excellence Madanpur Khadar', degree:'Senior Secondary', field:'Science Stream (PCM)', period:'Completed', status:'80%', courses:'' },
];
const certs = [
  { title:'Prompt Engineering for ChatGPT', issuer:'Coursera', date:'May 2026', id:'OAZ4B1SJF9JW', url:'https://coursera.org/verify/OAZ4B1SJF9JW' },
  { title:'Introduction to Artificial Intelligence', issuer:'Coursera', date:'March 2026', id:'DTZBNFPSJR97', url:'https://coursera.org/verify/DTZBNFPSJR97' },
];
const seminars = [
  { title:'AI Builders Weekend', organizer:"Masters' Union", location:'New Delhi', body:'Workshop on building AI agents from scratch using Python, including autonomous agent architecture, tool calling, and ReAct mechanics.' },
  { title:'National Seminar on AI for Good Governance', organizer:'Dr. Ambedkar International Centre', location:'New Delhi', body:'National deliberations covering India AI Mission, Project Tapestry, Distributed AI, DSS Studio, sovereignty, ethics, and governance.' },
];
---
<Layout title="About | Kaushal Kumar">
  <div class="page-intro"><span class="mono">01 / ABOUT</span><h1>Curious about systems, serious about learning.</h1><p>I am Kaushal Kumar, a Mathematics &amp; Computing student building practical AI, computer vision, edge systems, robotics, and technical workflows. I learn by shipping, measuring, and explaining what I build.</p></div>

  <section class="identity-band panel"><div><span class="kicker">CURRENT DIRECTION</span><h2>AI systems with a strong mathematical foundation.</h2></div><div class="focus-grid"><span>Computer Vision</span><span>Machine Learning</span><span>Embedded Systems</span><span>Robotics</span><span>Python / C++</span><span>Technical Mentorship</span></div></section>

  <section class="section"><div class="section-head"><div><span class="kicker">EDUCATION</span><h2>Foundation</h2></div><p>The academic track behind the engineering work.</p></div><div class="stack">{education.map((e)=><article class="card"><div class="card-index">EDU</div><div><div class="meta">{e.period} · {e.status}</div><h3>{e.institution}</h3><strong>{e.degree} · {e.field}</strong>{e.courses && <p>{e.courses}</p>}</div></article>)}</div></section>

  <section class="section"><div class="section-head"><div><span class="kicker">CREDENTIALS</span><h2>Learning beyond the classroom.</h2></div><p>Selected credentials with verification links.</p></div><div class="grid">{certs.map((c)=><article class="card credential"><div class="credential-top"><span class="tag">{c.issuer}</span><span class="meta">{c.date}</span></div><h3>{c.title}</h3><code>{c.id}</code><a class="text-link" href={c.url} target="_blank" rel="noreferrer">Verify credential ↗</a></article>)}</div></section>

  <section class="section"><div class="section-head"><div><span class="kicker">SEMINARS &amp; WORKSHOPS</span><h2>Exposure to the wider field.</h2></div></div><div class="grid">{seminars.map((s)=><article class="card"><span class="tag mint">{s.location}</span><h3>{s.title}</h3><div class="meta">{s.organizer}</div><p>{s.body}</p></article>)}</div></section>
</Layout>
<style>
.page-intro{max-width:850px;padding:38px 0 62px}.mono,.meta,.kicker{font:10px 'JetBrains Mono';color:var(--blue);letter-spacing:.08em}.page-intro h1{font-size:clamp(45px,6.5vw,76px);line-height:.98;letter-spacing:-.06em;margin:13px 0}.page-intro p{max-width:760px;color:#96a2b3;font-size:15px;line-height:1.8}.panel,.card{border:1px solid var(--line);background:var(--panel);backdrop-filter:blur(14px);border-radius:17px}.identity-band{display:grid;grid-template-columns:1.1fr .9fr;gap:28px;padding:24px}.identity-band h2{margin:9px 0 0;font-size:25px;line-height:1.22;letter-spacing:-.035em}.focus-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}.focus-grid span{padding:10px;border:1px solid rgba(255,255,255,.06);border-radius:9px;background:rgba(255,255,255,.018);color:#a9b5c5;font:9px 'JetBrains Mono'}.section{padding-top:82px}.section-head{display:flex;align-items:end;justify-content:space-between;gap:25px;margin-bottom:16px}.section-head h2{margin:7px 0 0;font-size:29px;letter-spacing:-.04em}.section-head p{margin:0;color:#6f7d90;font-size:11px}.stack,.grid{display:grid;gap:10px}.card{padding:19px}.stack .card{display:grid;grid-template-columns:45px 1fr;gap:17px;align-items:start}.card-index{font:10px 'JetBrains Mono';color:#526176;padding-top:2px}.card h3{margin:10px 0 5px;font-size:18px;letter-spacing:-.02em}.card strong{font-size:12px;color:#cad5e1;font-weight:500}.card p{margin:14px 0 0;color:#8190a3;font-size:11px;line-height:1.7}.grid{grid-template-columns:1fr 1fr}.credential-top{display:flex;justify-content:space-between;gap:12px;align-items:center}.tag{display:inline-block;padding:4px 6px;border-radius:6px;border:1px solid rgba(88,182,255,.16);background:rgba(88,182,255,.035);color:#78cafb;font:9px 'JetBrains Mono'}.tag.mint{color:#72ddb8;border-color:rgba(94,230,178,.15);background:rgba(94,230,178,.035)}code{display:block;margin:15px 0 11px;padding:9px 10px;border:1px solid rgba(255,255,255,.06);background:#080c12;border-radius:8px;color:#a9b9cf;font:9px 'JetBrains Mono'}.text-link{color:#bceff4;font-size:11px}.credential h3{font-size:19px;max-width:340px}@media(max-width:720px){.identity-band,.grid{grid-template-columns:1fr}.section-head{align-items:flex-start;flex-direction:column;gap:7px}.page-intro{padding-top:24px}}
</style>
