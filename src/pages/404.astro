---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404 | Kaushal Kumar" description="The requested page could not be found.">
  <section class="not-found">
    <span class="code">404 / NOT FOUND</span>
    <h1>That page is not in the system.</h1>
    <p>The route may have moved, or the link may be outdated. The main sections are one click away.</p>
    <a class="button" href="/">Return home <span>↗</span></a>
  </section>
</Layout>
<style>
.not-found{min-height:58vh;display:grid;align-content:center;max-width:720px}.code{font:10px 'JetBrains Mono';color:var(--accent);letter-spacing:.1em}.not-found h1{margin:15px 0 12px;font-size:clamp(42px,6vw,76px);line-height:.98;letter-spacing:-.06em}.not-found p{max-width:580px;color:var(--text-dim);font-size:15px;line-height:1.75}.button{display:inline-flex;justify-self:start;margin-top:18px;padding:11px 14px;border-radius:9px;background:var(--text);color:var(--bg);font-size:12px;font-weight:600}
</style>
