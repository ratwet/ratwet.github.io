---
import Layout from '../layouts/Layout.astro';
const projects = [
  {id:'finger',category:'Computer Vision',year:'2026',title:'Finger Gesture Cursor Control',result:'A local computer-vision interface that maps hand gestures to cursor actions.',summary:'The project explores human-computer interaction through hand landmarks and gesture mapping, with a CPU-first, offline-capable workflow.',stack:['Python','MediaPipe','OpenCV','evdev','uinput','NumPy'],details:['21-point hand landmark tracking','Index point maps to smooth cursor movement','Pinch gestures trigger clicks','Peace sign enables vertical scroll','Fist enables freeze or precision lock'],repo:'https://github.com/ratwet/finger-gesture-cursor'},
  {id:'iot',category:'Edge & IoT',year:'2026',title:'ESP32 IoT Device Simulator',result:'A virtual edge-device environment for developing and validating MQTT telemetry flows.',summary:'The simulator models sensors and device behavior so an IoT pipeline can be tested before physical deployment.',stack:['ESP32','Arduino C++','Wokwi','MQTT','HiveMQ','JSON'],details:['DHT22 temperature and humidity sensor','SSD1306 I2C OLED 128x64','LED status indicators','Push-button inputs','Telemetry for environment, battery, and GPS fields'],repo:'https://github.com/ratwet/esp32-iot-simulator'},
  {id:'robo',category:'Robotics',year:'2026',title:'Robo Soccer / NSECT-2026',result:'A wireless differential-drive robot controlled through a browser-based multi-touch interface.',summary:'The system combines embedded control, Wi-Fi networking, and a mobile-friendly browser interface into one field-ready prototype.',stack:['ESP32','Arduino C++','HTML5 Canvas','CSS Grid','JavaScript'],details:['Robot hosts its own Wi-Fi hotspot','Responsive browser gamepad for phones','No external router required','Wireless control through the browser'],repo:'https://github.com/ratwet/robo-soccer-nsect'},
];
---
<Layout title="Projects | Kaushal Kumar">
  <div class="page-intro"><span class="mono">03 / PROJECTS</span><h1>Selected builds, explained like engineering work.</h1><p>Each project starts with the result and then gives just enough technical context to understand the problem, the system, and the tradeoffs. Detailed benchmark figures are intentionally omitted until I can stand behind current measurements.</p></div>
  <div class="filters" aria-label="Project categories"><button class="active" data-filter="all">All projects</button><button data-filter="Computer Vision">Computer Vision</button><button data-filter="Edge & IoT">Edge &amp; IoT</button><button data-filter="Robotics">Robotics</button></div>
  <section class="project-grid">{projects.map(p=><article class="project" data-category={p.category}><div class="project-top"><div><span class="tag">{p.category}</span><span class="year">{p.year}</span></div><a href={p.repo} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div><div class="project-title-row"><h2>{p.title}</h2><span class="case-index">{p.id}</span></div><div class="result"><span class="block-label">RESULT</span><strong>{p.result}</strong></div><p class="summary">{p.summary}</p><div class="detail-block"><span class="block-label">IMPLEMENTATION NOTES</span><div class="details">{p.details.map(d=><span><b>+</b>{d}</span>)}</div></div><div class="stack"><span class="block-label">STACK</span><div>{p.stack.map(s=><span>{s}</span>)}</div></div></article>)}</section>
</Layout>
<script>
const buttons=[...document.querySelectorAll<HTMLButtonElement>('.filters button')];const cards=[...document.querySelectorAll<HTMLElement>('.project')];buttons.forEach(button=>button.addEventListener('click',()=>{buttons.forEach(b=>b.classList.remove('active'));button.classList.add('active');const filter=button.dataset.filter||'all';cards.forEach(card=>{card.hidden=filter!=='all'&&card.dataset.category!==filter})}));
</script>
<style>
.page-intro{max-width:900px;padding:38px 0 48px}.mono,.block-label{font:10px 'JetBrains Mono';color:var(--accent);letter-spacing:.08em}.page-intro h1{font-size:clamp(44px,6.5vw,76px);line-height:.98;letter-spacing:-.06em;margin:13px 0}.page-intro p{max-width:760px;color:var(--text-dim);font-size:14px;line-height:1.8}.filters{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:13px}.filters button{padding:8px 10px;border:1px solid var(--border);border-radius:8px;background:rgba(255,255,255,.025);color:#7f8da0;cursor:pointer;font:9px 'JetBrains Mono';transition:border-color var(--dur) var(--ease),background var(--dur) var(--ease),color var(--dur) var(--ease)}.filters button:hover,.filters button.active{color:#dffaff;border-color:rgba(76,201,240,.3);background:var(--accent-soft)}.project-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:11px}.project{display:flex;flex-direction:column;min-height:545px;padding:19px;border:1px solid var(--border);background:var(--panel);backdrop-filter:blur(14px);border-radius:17px;transition:transform var(--dur) var(--ease),border-color var(--dur) var(--ease),background var(--dur) var(--ease)}.project:hover{transform:translateY(-3px);border-color:rgba(76,201,240,.25);background:rgba(18,23,32,.9)}.project[hidden]{display:none}.project-top{display:flex;align-items:center;justify-content:space-between;font:10px 'JetBrains Mono';color:#6d7a8e}.project-top>div{display:flex;align-items:center;gap:7px}.tag{padding:4px 6px;border-radius:6px;border:1px solid rgba(76,201,240,.16);background:rgba(76,201,240,.035);color:#7ccff1;font:9px 'JetBrains Mono'}.year{color:#566377}.project-top a{color:#a9b5c6}.project-top a:hover{color:#f0fbff}.project-title-row{display:flex;justify-content:space-between;gap:12px;align-items:start;margin-top:33px}.project h2{margin:0;font-size:25px;line-height:1.08;letter-spacing:-.04em}.case-index{color:#455268;font:10px 'JetBrains Mono'}.result{margin-top:17px;padding:13px;border-left:2px solid var(--accent);background:rgba(76,201,240,.045);border-radius:0 9px 9px 0}.result strong{display:block;margin-top:7px;color:#d7f6f9;font-size:12px;line-height:1.55}.summary{color:#8a98aa;font-size:12px;line-height:1.7;margin:16px 0 20px}.detail-block{padding-top:17px;border-top:1px solid var(--border)}.details{display:grid;gap:7px;margin-top:10px}.details span{color:#8492a5;font-size:10px;line-height:1.55}.details b{color:var(--signal);font-weight:500;margin-right:7px}.stack{margin-top:auto;padding-top:18px}.stack>div{display:flex;gap:5px;flex-wrap:wrap;margin-top:9px}.stack>div span{padding:4px 6px;border:1px solid rgba(255,255,255,.06);border-radius:6px;color:#69778b;font:8px 'JetBrains Mono'}@media(max-width:980px){.project-grid{grid-template-columns:1fr 1fr}}@media(max-width:680px){.project-grid{grid-template-columns:1fr}.project{min-height:0}.page-intro{padding-top:24px}}
</style>
