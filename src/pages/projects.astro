---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const projects = (await getCollection('projects')).sort((a, b) => Number(b.data.year) - Number(a.data.year) || a.id.localeCompare(b.id));
const categories = [...new Set(projects.map((project) => project.data.category))];
---
<Layout title="Work | Kaushal Kumar" description="Selected projects by Kaushal Kumar across computer vision, embedded systems, machine learning, and robotics.">
  <header class="page-heading"><p class="eyebrow">Work</p><h1>Builds that are easier to inspect than to hype.</h1><p>The archive is organized around what each system does, why it is interesting, and what another developer can inspect in the repository.</p></header>
  <div class="filters" aria-label="Filter projects"><button class="active" data-filter="all">All</button>{categories.map((category) => <button data-filter={category}>{category}</button>)}</div>
  <section class="project-list">
    {projects.map((project) => <article class="project-row" data-category={project.data.category}>
      <div class="project-heading"><div><span class="tag">{project.data.category}</span><span class="year">{project.data.year}</span></div><span class="status">{project.data.status}</span></div>
      <h2>{project.data.title}</h2>
      <p>{project.data.summary}</p>
      {project.data.metrics && <div class="metrics">{project.data.metrics.map((metric) => <span><b>{metric.value}</b>{metric.label}</span>)}</div>}
      <div class="project-bottom"><a href={`/projects/${project.id}/`}>Open case study ↗</a>{project.data.repoUrl && <a href={project.data.repoUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}</div>
    </article>)}
  </section>
</Layout>
<script>
const buttons=[...document.querySelectorAll<HTMLButtonElement>('.filters button')];const cards=[...document.querySelectorAll<HTMLElement>('.project-row')];buttons.forEach(button=>button.addEventListener('click',()=>{buttons.forEach(item=>item.classList.remove('active'));button.classList.add('active');const filter=button.dataset.filter||'all';cards.forEach(card=>card.hidden=filter!=='all'&&card.dataset.category!==filter)}));
</script>
<style>
.page-heading{max-width:820px;padding:45px 0 54px}.eyebrow{margin:0 0 14px;color:var(--color-signal);font:12px var(--font-mono)}.page-heading h1{max-width:790px;margin:0;font-size:var(--step-5);line-height:1;letter-spacing:-.055em}.page-heading>p:last-child{max-width:700px;margin:23px 0 0;color:var(--color-ink-dim);font-size:17px;line-height:1.75}.filters{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}.filters button{padding:7px 9px;border:1px solid var(--color-border);border-radius:var(--radius-md);background:var(--color-surface);color:var(--color-ink-dim);cursor:pointer;font:10px var(--font-mono)}.filters button:hover,.filters button.active{color:var(--color-signal);border-color:var(--color-signal);background:var(--color-signal-dim)}.project-list{border-top:1px solid var(--color-border)}.project-row{display:grid;grid-template-columns:1fr auto;gap:8px 25px;padding:25px 4px;border-bottom:1px solid var(--color-border);transition:background var(--duration-base) var(--ease-out),padding-left var(--duration-base) var(--ease-out)}.project-row:hover{padding-left:10px;background:color-mix(in srgb,var(--color-signal-dim) 48%,transparent)}.project-row[hidden]{display:none}.project-heading{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;gap:20px}.project-heading>div{display:flex;align-items:center;gap:8px}.tag{display:inline-block;padding:4px 6px;border:1px solid var(--color-border);border-radius:var(--radius-md);color:var(--color-signal);background:var(--color-surface);font:9px var(--font-mono)}.year,.status{color:var(--color-ink-faint);font:10px var(--font-mono)}.project-row h2{margin:5px 0 0;font-size:25px;letter-spacing:-.035em}.project-row>p{max-width:760px;margin:3px 0 0;color:var(--color-ink-dim);font-size:13px;line-height:1.7}.metrics{display:flex;flex-wrap:wrap;gap:7px;align-self:end;justify-content:flex-end}.metrics span{display:grid;gap:2px;min-width:85px;padding:8px 9px;border:1px solid var(--color-border);background:var(--color-bg);border-radius:var(--radius-sm);color:var(--color-ink-faint);font:8px var(--font-mono)}.metrics b{color:var(--color-ink);font-size:11px;font-weight:500}.project-bottom{grid-column:1/-1;display:flex;gap:15px;margin-top:13px;padding-top:14px;border-top:1px solid var(--color-border);font:10px var(--font-mono)}.project-bottom a{color:var(--color-signal)}@media(max-width:720px){.project-row{grid-template-columns:1fr}.metrics{justify-content:flex-start}.page-heading{padding-top:28px}}
</style>
