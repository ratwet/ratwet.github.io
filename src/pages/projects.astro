---
import Layout from '../layouts/Layout.astro';
const projects = [
  {id:'finger',category:'AI / Computer Vision',title:'Finger Gesture Cursor Control',summary:'Real-time human-computer interaction engine mapping hand gestures to Wayland cursor actions without GPU overhead.',stack:['Python 3.12','MediaPipe','OpenCV','evdev','uinput','NumPy'],metrics:['~40 FPS','<25ms latency','CPU only','Offline'],details:['Index point → smooth cursor movement','Thumb + index pinch → left click','Thumb + middle pinch → right click','Peace sign → vertical scroll','Fist → freeze / precision lock'],repo:'https://github.com/ratwet/finger-gesture-cursor'},
  {id:'iot',category:'IoT & Embedded',title:'ESP32 IoT Device Simulator',summary:'Virtual edge-device environment for validating MQTT pipelines, brokers, and telemetry dashboards.',stack:['ESP32','Arduino C++','Wokwi','MQTT','HiveMQ','JSON'],metrics:['MQTT/WebSockets','1s interval','DHT22 + OLED','Live JSON'],details:['DHT22 temperature & humidity sensor','SSD1306 I2C OLED 128×64','LED status indicators','Push-button inputs','Telemetry: temperature, humidity, battery %, GPS'],repo:'https://github.com/ratwet/esp32-iot-simulator'},
  {id:'robo',category:'Robotics & Web',title:'Robo Soccer · NSECT-2026',summary:'High-mobility 4-wheel differential-drive wireless robot with a browser-based multi-touch control interface.',stack:['ESP32','Arduino C++','HTML5 Canvas','CSS Grid','JavaScript'],metrics:['4-wheel differential','Wi-Fi AP','<15ms loop','Multi-touch'],details:['Robot hosts its own Wi-Fi hotspot','Responsive web gamepad for phones','No external router required','Wireless control via browser'],repo:'https://github.com/ratwet/robo-soccer-nsect'},
];
---
<Layout title="Projects — Kaushal Kumar"><div class="page-intro"><span class="mono">03 / projects</span><h1>Technical work, with the numbers left in.</h1><p>Three representative systems across computer vision, edge IoT, and robotics. Every card is designed to answer the useful questions: what, how, and how fast?</p></div><div class="filters" aria-label="Project categories"><button class="active" data-filter="all">All</button><button data-filter="AI / Computer Vision">AI / Computer Vision</button><button data-filter="IoT & Embedded">IoT &amp; Embedded</button><button data-filter="Robotics & Web">Robotics &amp; Web</button></div><section class="project-grid">{projects.map(p=><article class="project" data-category={p.category}><div class="project-top"><span class="tag">{p.category}</span><a href={p.repo} target="_blank" rel="noreferrer">repo ↗</a></div><h2>{p.title}</h2><p>{p.summary}</p><div class="metrics">{p.metrics.map(m=><span>{m}</span>)}</div><div class="details">{p.details.map(d=><span>+ {d}</span>)}</div><div class="stack">{p.stack.map(s=><span>{s}</span>)}</div></article>)}</section></Layout>
<script>
const buttons=[...document.querySelectorAll<HTMLButtonElement>('.filters button')];const cards=[...document.querySelectorAll<HTMLElement>('.project')];buttons.forEach(button=>button.addEventListener('click',()=>{buttons.forEach(b=>b.classList.remove('active'));button.classList.add('active');const filter=button.dataset.filter||'all';cards.forEach(card=>{card.hidden=filter!=='all'&&card.dataset.category!==filter})}));
</script>
<style>
.page-intro{max-width:800px;padding:40px 0 48px}.mono{font:12px 'JetBrains Mono';color:#38bdf8}.page-intro h1{font-size:clamp(42px,6vw,70px);line-height:1;letter-spacing:-.055em;margin:14px 0}.page-intro p{color:#93a1b5;line-height:1.75}.filters{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:16px}.filters button{font:10px 'JetBrains Mono';color:#8795aa;background:rgba(255,255,255,.03);border:1px solid var(--line);border-radius:8px;padding:8px 10px;cursor:pointer}.filters button.active,.filters button:hover{color:#e6fbff;border-color:rgba(56,189,248,.24);background:rgba(56,189,248,.06)}.project-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.project{border:1px solid var(--line);background:rgba(15,23,42,.54);border-radius:16px;padding:19px;display:flex;flex-direction:column;min-height:430px}.project[hidden]{display:none}.project-top{display:flex;justify-content:space-between;align-items:center;font:11px 'JetBrains Mono';color:#77859a}.tag{font:10px 'JetBrains Mono';color:#7dd3fc;padding:5px 7px;border:1px solid rgba(56,189,248,.18);border-radius:7px;background:rgba(56,189,248,.05)}.project h2{font-size:25px;line-height:1.1;letter-spacing:-.035em;margin:34px 0 10px}.project p{color:#8f9eb2;font-size:13px;line-height:1.7}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin:15px 0}.metrics span{padding:9px;background:#090d14;border:1px solid rgba(255,255,255,.05);border-radius:8px;color:#b4f7ff;font:10px 'JetBrains Mono'}.details{display:grid;gap:7px;margin-top:8px}.details span{color:#8391a6;font-size:11px;line-height:1.5}.stack{display:flex;gap:6px;flex-wrap:wrap;margin-top:auto;padding-top:20px}.stack span{font:9px 'JetBrains Mono';color:#718096;border:1px solid rgba(255,255,255,.06);padding:4px 6px;border-radius:6px}@media(max-width:950px){.project-grid{grid-template-columns:1fr 1fr}}@media(max-width:650px){.project-grid{grid-template-columns:1fr}}
</style>
