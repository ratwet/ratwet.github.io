---
import Layout from '../layouts/Layout.astro';
const projects = [
  {id:'finger',category:'Computer Vision',year:'2026',title:'Finger Gesture Cursor Control',summary:'Real-time human-computer interaction engine mapping hand gestures to Wayland cursor actions without GPU overhead.',stack:['Python 3.12','MediaPipe','OpenCV','evdev','uinput','NumPy'],metrics:['~40 FPS','<25ms latency','CPU only','Offline'],details:['21-point hand landmark tracking','Index point maps to smooth cursor movement','Pinch gestures trigger clicks','Peace sign enables vertical scroll','Fist enables freeze / precision lock'],repo:'https://github.com/ratwet/finger-gesture-cursor'},
  {id:'iot',category:'Edge & IoT',year:'2026',title:'ESP32 IoT Device Simulator',summary:'Virtual edge-device environment for validating MQTT pipelines, brokers, and telemetry dashboards.',stack:['ESP32','Arduino C++','Wokwi','MQTT','HiveMQ','JSON'],metrics:['1s telemetry','MQTT / WebSockets','DHT22 + OLED','Live JSON'],details:['DHT22 temperature and humidity sensor','SSD1306 I2C OLED 128×64','LED status indicators','Push-button inputs','Telemetry for environment, battery, and GPS fields'],repo:'https://github.com/ratwet/esp32-iot-simulator'},
  {id:'robo',category:'Robotics',year:'2026',title:'Robo Soccer · NSECT-2026',summary:'High-mobility 4-wheel differential-drive wireless robot with a browser-based multi-touch control interface.',stack:['ESP32','Arduino C++','HTML5 Canvas','CSS Grid','JavaScript'],metrics:['4-wheel differential','Wi-Fi AP','<15ms loop','Multi-touch'],details:['Robot hosts its own Wi-Fi hotspot','Responsive browser gamepad for phones','No external router required','Wireless control through the browser'],repo:'https://github.com/ratwet/robo-soccer-nsect'},
];
---
<Layout title="Projects | Kaushal Kumar">
  <div class="page-intro"><span class="mono">03 / PROJECTS</span><h1>Selected builds, explained like engineering work.</h1><p>Three representative systems across computer vision, edge IoT, and robotics. The goal is not a technology list. It is to make the problem, implementation, and measurable behavior easy to understand.</p></div>
  <div class="filters" aria-label="Project categories"><button class="active" data-filter="all">All projects</button><button data-filter="Computer Vision">Computer Vision</button><button data-filter="Edge & IoT">Edge &amp; IoT</button><button data-filter="Robotics">Robotics</button></div>
  <section class="project-grid">{projects.map(p=><article class="project" data-category={p.category}><div class="project-top"><div><span class="tag">{p.category}</span><span class="year">{p.year}</span></div><a href={p.repo} target="_blank" rel="noreferrer">GitHub ↗</a></div><div class="project-title-row"><h2>{p.title}</h2><span class="case-index">{p.id}</span></div><p class="summary">{p.summary}</p><div class="metrics">{p.metrics.map(m=><span>{m}</span>)}</div><div class="detail-block"><span class="block-label">IMPLEMENTATION NOTES</span><div class="details">{p.details.map(d=><span><b>+</b>{d}</span>)}</div></div><div class="stack"><span class="block-label">STACK</span><div>{p.stack.map(s=><span>{s}</span>)}</div></div></article>)}</section>
</Layout>
<script>
const buttons=[...document.querySelectorAll<HTMLButtonElement>('.filters button')];const cards=[...document.querySelectorAll<HTMLElement>('.project')];buttons.forEach(button=>button.addEventListener('click',()=>{buttons.forEach(b=>b.classList.remove('active'));button.classList.add('active');const filter=button.dataset.filter||'all';cards.forEach(card=>{card.hidden=filter!=='all'&&card.dataset.category!==filter})}));
</script>
<style>
.page-intro{max-width:900px;padding:38px 0 48px}.mono,.block-label{font:10px 'JetBrains Mono';color:var(--blue);letter-spacing:.08em}.page-intro h1{font-size:clamp(44px,6.5vw,76px);line-height:.98;letter-spacing:-.06em;margin:13px 0}.page-intro p{max-width:760px;color:#96a2b3;font-size:14px;line-height:1.8}.filters{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:13px}.filters button{padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:rgba(255,255,255,.025);color:#7f8da0;cursor:pointer;font:9px 'JetBrains Mono';transition:border-color .2s,background .2s,color .2s}.filters button:hover,.filters button.active{color:#dffaff;border-color:rgba(124,236,255,.24);background:rgba(124,236,255,.045)}.project-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:11px}.project{display:flex;flex-direction:column;min-height:520px;padding:19px;border:1px solid var(--line);background:var(--panel);backdrop-filter:blur(14px);border-radius:17px;transition:transform .2s,border-color .2s,background .2s}.project:hover{transform:translateY(-3px);border-color:rgba(124,236,255,.22);background:rgba(17,24,38,.8)}.project[hidden]{display:none}.project-top{display:flex;align-items:center;justify-content:space-between;font:10px 'JetBrains Mono';color:#6d7a8e}.project-top>div{display:flex;align-items:center;gap:7px}.tag{padding:4px 6px;border-radius:6px;border:1px solid rgba(88,182,255,.15);background:rgba(88,182,255,.035);color:#7bcafb;font:9px 'JetBrains Mono'}.year{color:#566377}.project-top a{color:#a9b5c6}.project-top a:hover{color:#e9fbff}.project-title-row{display:flex;justify-content:space-between;gap:12px;align-items:start;margin-top:34px}.project h2{margin:0;font-size:25px;line-height:1.08;letter-spacing:-.04em}.case-index{color:#455268;font:10px 'JetBrains Mono'}.summary{color:#8a98aa;font-size:12px;line-height:1.7;margin:11px 0 17px}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:22px}.metrics span{padding:9px 10px;border:1px solid rgba(255,255,255,.06);background:#090d13;border-radius:8px;color:#c0f5fa;font:9px 'JetBrains Mono'}.detail-block{padding-top:17px;border-top:1px solid var(--line)}.details{display:grid;gap:7px;margin-top:10px}.details span{color:#8492a5;font-size:10px;line-height:1.55}.details b{color:#64d7ad;font-weight:500;margin-right:7px}.stack{margin-top:auto;padding-top:18px}.stack>div{display:flex;gap:5px;flex-wrap:wrap;margin-top:9px}.stack>div span{padding:4px 6px;border:1px solid rgba(255,255,255,.06);border-radius:6px;color:#69778b;font:8px 'JetBrains Mono'}@media(max-width:980px){.project-grid{grid-template-columns:1fr 1fr}}@media(max-width:680px){.project-grid{grid-template-columns:1fr}.project{min-height:0}.page-intro{padding-top:24px}}
</style>
