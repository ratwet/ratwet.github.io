---
import Layout from '../layouts/Layout.astro';
const projects = [
  { title:'Finger Gesture Cursor Control', category:'AI / Computer Vision', metric:'~40 FPS · <25ms', href:'/projects/' },
  { title:'ESP32 IoT Device Simulator', category:'IoT & Embedded', metric:'MQTT · 1s telemetry', href:'/projects/' },
  { title:'Robo Soccer — NSECT-2026', category:'Robotics & Web', metric:'<15ms control loop', href:'/projects/' },
];
---
<Layout>
  <section class="hero">
    <div class="eyebrow"><span class="pulse"></span> OPEN TO RESEARCH &amp; AI ENGINEERING COLLABORATIONS</div>
    <p class="mono intro">// command center / kaushal kumar</p>
    <h1>Building at the intersection of <span>AI, systems &amp; mathematics.</span></h1>
    <p class="lede">B.Tech Mathematics &amp; Computing student at CUJ. I build computer-vision interfaces, edge-IoT systems, robotics controls, and practical AI experiments — and mentor other builders along the way.</p>
    <div class="actions"><a class="primary" href="/projects/">Explore projects <span>↗</span></a><a class="secondary" href="/about/">View credentials</a></div>
  </section>
  <section class="stats" aria-label="Selected metrics"><div><strong>3+</strong><span>Engineering projects</span></div><div><strong>74.07%</strong><span>CNN CIFAR-10 accuracy</span></div><div><strong>&lt;25ms</strong><span>Vision control latency</span></div><div><strong>~40 FPS</strong><span>CPU inference</span></div></section>
  <section class="split"><div class="panel large-card"><div class="panel-head"><span>Featured build</span><span class="tag">COMPUTER VISION</span></div><div class="terminal-card"><div class="terminal-head"><i></i><i></i><i></i><span>gesture-control — live trace</span></div><pre><code><span>$</span> python gesture_cursor.py

camera        : online
hand landmarks: 21
tracking      : stable
latency       : <span class="green">18ms</span>
throughput    : <span class="cyan">40 FPS</span>
gpu required  : no
mode          : offline

&gt; index + thumb pinch → <b>LEFT CLICK</b>
&gt; peace sign        → <b>SCROLL</b>
&gt; fist              → <b>FREEZE</b></code></pre></div></div><div class="panel note-card"><span class="tag mint">CURRENT FOCUS</span><h2>Engineering with measurable constraints.</h2><p>I care about latency, model behavior, hardware boundaries, clean architecture, and making technical work understandable to the next person.</p><a class="text-link" href="/experience/">See experience →</a></div></section>
  <section class="section-block"><div class="section-title"><div><span class="mono">01 / selected work</span><h2>Systems I’ve built</h2></div><a class="text-link" href="/projects/">View all →</a></div><div class="project-grid">{projects.map((p) => <a class="project-card" href={p.href}><span class="tag">{p.category}</span><h3>{p.title}</h3><p>{p.metric}</p><span class="arrow">↗</span></a>)}</div></section>
  <section class="cta panel"><div><span class="mono">02 / connect</span><h2>Have a research problem or a system to prototype?</h2><p>Let’s compare notes, build a proof-of-concept, or turn the idea into something measurable.</p></div><a class="primary" href="/contact/">Open contact hub <span>→</span></a></section>
</Layout>
<style>
.hero{max-width:930px;padding:54px 0 68px}.eyebrow{display:inline-flex;align-items:center;gap:9px;border:1px solid rgba(16,185,129,.22);background:rgba(16,185,129,.05);padding:8px 11px;border-radius:999px;color:#9de4c8;font:11px 'JetBrains Mono',monospace;letter-spacing:.05em}.pulse{width:7px;height:7px;border-radius:50%;background:#10b981;box-shadow:0 0 15px #10b981}.mono{font:12px 'JetBrains Mono',monospace;color:#38bdf8}.intro{margin:28px 0 14px;color:#66758d}.hero h1{margin:0;font-size:clamp(44px,7vw,82px);line-height:1.01;letter-spacing:-.055em;max-width:900px}.hero h1 span{color:#8beaf1}.lede{max-width:720px;color:#94a3b8;font-size:17px;line-height:1.8;margin:24px 0}.actions{display:flex;gap:10px;flex-wrap:wrap}.primary,.secondary{display:inline-flex;align-items:center;gap:10px;padding:12px 16px;border-radius:11px;font-size:13px;font-weight:600}.primary{background:#f8fafc;color:#07090e}.secondary{border:1px solid var(--line);color:#cbd5e1;background:rgba(255,255,255,.03)}.primary:hover{transform:translateY(-1px)}.stats{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);border-radius:16px;background:rgba(15,23,42,.46);overflow:hidden}.stats div{padding:21px;border-right:1px solid var(--line)}.stats div:last-child{border-right:0}.stats strong{display:block;font:700 24px 'JetBrains Mono';letter-spacing:-.04em}.stats span{display:block;color:#708099;font-size:11px;margin-top:7px}.split{display:grid;grid-template-columns:1.45fr .8fr;gap:14px;margin-top:14px}.panel,.project-card{border:1px solid var(--line);background:rgba(15,23,42,.56);backdrop-filter:blur(14px);border-radius:18px}.large-card,.note-card{padding:18px}.panel-head,.section-title{display:flex;justify-content:space-between;align-items:center}.panel-head{font:11px 'JetBrains Mono';color:#708099}.tag{font:10px 'JetBrains Mono';color:#7dd3fc;padding:5px 7px;border:1px solid rgba(56,189,248,.18);border-radius:7px;background:rgba(56,189,248,.05)}.tag.mint{color:#6ee7b7;border-color:rgba(16,185,129,.18);background:rgba(16,185,129,.05)}.terminal-card{margin-top:15px;border:1px solid rgba(255,255,255,.07);border-radius:12px;overflow:hidden;background:#080b11}.terminal-head{display:flex;align-items:center;gap:6px;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,.06);font:10px 'JetBrains Mono';color:#65748b}.terminal-head i{width:7px;height:7px;border-radius:50%;background:#263244}.terminal-head span{margin-left:5px}.terminal-card pre{margin:0;padding:18px;font:12px/1.8 'JetBrains Mono';color:#b7c3d4;white-space:pre-wrap}.terminal-card pre span,.cyan{color:#22d3ee}.green{color:#6ee7b7}.terminal-card b{color:#e2e8f0}.note-card{display:flex;flex-direction:column;justify-content:center}.note-card h2{font-size:27px;line-height:1.2;letter-spacing:-.03em;margin:16px 0 10px}.note-card p{color:#8b99ac;line-height:1.7;font-size:14px}.text-link{color:#d8f9ff;font-size:13px}.section-block{margin-top:78px}.section-title{margin-bottom:18px}.section-title h2{margin:7px 0 0;font-size:30px;letter-spacing:-.04em}.project-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.project-card{position:relative;padding:18px;min-height:190px;transition:transform .2s,border-color .2s}.project-card:hover{transform:translateY(-3px);border-color:rgba(56,189,248,.25)}.project-card h3{font-size:20px;line-height:1.2;letter-spacing:-.025em;margin:30px 0 10px}.project-card p{font:11px 'JetBrains Mono';color:#718096}.arrow{position:absolute;right:16px;bottom:14px;color:#38bdf8}.cta{margin-top:88px;padding:26px;display:flex;align-items:center;justify-content:space-between;gap:20px}.cta h2{margin:8px 0;font-size:26px;letter-spacing:-.03em}.cta p{margin:0;color:#8b99ac;font-size:14px}@media(max-width:850px){.stats{grid-template-columns:repeat(2,1fr)}.stats div:nth-child(2){border-right:0}.split,.project-grid{grid-template-columns:1fr}.cta{align-items:flex-start;flex-direction:column}}@media(max-width:540px){.stats{grid-template-columns:1fr}.stats div{border-right:0;border-bottom:1px solid var(--line)}.stats div:last-child{border-bottom:0}.hero h1{font-size:46px}.lede{font-size:15px}}
</style>
