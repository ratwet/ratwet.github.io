---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const projects = (await getCollection('projects'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.id.localeCompare(b.id));
---
<Layout>
  <section class="hero">
    <div class="hero-field" aria-hidden="true"><canvas id="calibration-field"></canvas><div class="field-caption">flow / calibration / 01</div></div>
    <div class="hero-copy">
      <p class="eyebrow">Mathematics &amp; Computing student</p>
      <h1>I build and explain applied AI systems.</h1>
      <p class="lede">My work spans computer vision, embedded systems, robotics, and machine learning. I like taking an idea from a clear constraint to a working prototype, then understanding the behavior well enough to explain it.</p>
      <div class="actions"><a class="primary" href="/projects/">See selected work</a><a class="secondary" href="/contact/">Get in touch</a></div>
    </div>
  </section>

  <section class="facts" aria-label="Profile summary">
    <div><span>Focus</span><strong>Computer Vision · ML · Embedded · Robotics</strong></div>
    <div><span>Education</span><strong>B.Tech Mathematics &amp; Computing · Central University of Jammu</strong></div>
    <div><span>Current</span><strong>Technical mentorship through e-Yantra at CUJ</strong></div>
  </section>

  <section class="section-block">
    <div class="section-heading"><div><span class="section-kicker">Selected work</span><h2>Projects worth opening.</h2></div><a class="text-link" href="/projects/">All work ↗</a></div>
    <div class="project-list">
      {projects.map((project, index) => (
        <a class="project-row" href={`/projects/${project.id}/`}>
          <span class="project-index">{String(index + 1).padStart(2, '0')}</span>
          <div><span class="tag">{project.data.category}</span><h3>{project.data.title}</h3><p>{project.data.summary}</p></div>
          <span class="project-arrow">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="method section-block">
    <div class="section-heading"><div><span class="section-kicker">How I work</span><h2>Frame, build, improve.</h2></div></div>
    <div class="method-grid">
      <article><span>01</span><h3>Frame</h3><p>Define the problem, the inputs, the constraints, and what a useful result means.</p></article>
      <article><span>02</span><h3>Build</h3><p>Create the smallest working system that exposes the important behavior.</p></article>
      <article><span>03</span><h3>Improve</h3><p>Test what matters, make tradeoffs explicit, and document what changed.</p></article>
    </div>
  </section>

  <section class="closing">
    <div><span class="section-kicker">Start a conversation</span><h2>Have a problem worth exploring?</h2><p>Internship, research opportunity, technical team, or a project that needs a prototype. I am interested in useful work with a clear learning loop.</p></div>
    <a class="primary" href="/contact/">Contact me</a>
  </section>

  <script>
    const canvas = document.querySelector('#calibration-field');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    if (canvas instanceof HTMLCanvasElement) {
      const ctx = canvas.getContext('2d');
      const host = canvas.parentElement;
      const points = Array.from({ length: 95 }, (_, i) => ({ x: (i * 0.173) % 1, y: (i * 0.379) % 1, phase: i * 0.21 }));
      let visible = true;
      const resize = () => { const rect = host?.getBoundingClientRect(); if (!rect || !ctx) return; const dpr = Math.min(devicePixelRatio || 1, 1.5); canvas.width = rect.width * dpr; canvas.height = rect.height * dpr; canvas.style.width = `${rect.width}px`; canvas.style.height = `${rect.height}px`; ctx.setTransform(dpr, 0, 0, dpr, 0, 0); };
      const draw = (time = 0) => {
        if (!ctx || !host) return;
        const rect = host.getBoundingClientRect();
        ctx.clearRect(0, 0, rect.width, rect.height);
        for (const point of points) {
          const x = point.x * rect.width;
          const y = ((point.y + (time * 0.000012) + Math.sin(x * 0.012 + point.phase) * 0.035) % 1) * rect.height;
          const angle = Math.sin(x * 0.009 + y * 0.006 + point.phase) * 0.65;
          const length = 8;
          ctx.save(); ctx.translate(x, y); ctx.rotate(angle); ctx.strokeStyle = 'currentColor'; ctx.globalAlpha = point.phase % 1 > 0.88 ? 0.35 : 0.1; ctx.beginPath(); ctx.moveTo(-length / 2, 0); ctx.lineTo(length / 2, 0); ctx.stroke(); ctx.restore();
        }
        ctx.globalAlpha = 1;
        ctx.strokeStyle = 'currentColor'; ctx.globalAlpha = 0.16; ctx.lineWidth = 1; ctx.beginPath(); ctx.arc(rect.width * 0.76, rect.height * 0.44, 36, 0, Math.PI * 2); ctx.stroke(); ctx.globalAlpha = 0.6; ctx.beginPath(); ctx.arc(rect.width * 0.76, rect.height * 0.44, 2, 0, Math.PI * 2); ctx.fill();
      };
      const observer = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; if (visible && !reduce.matches) requestAnimationFrame(loop); }, { threshold: 0.02 });
      observer.observe(host);
      const loop = (time) => { if (!visible || reduce.matches) return; draw(time); requestAnimationFrame(loop); };
      addEventListener('resize', resize, { passive: true }); resize(); draw();
      if (!reduce.matches) requestAnimationFrame(loop);
    }
  </script>
</Layout>
<style>
.hero{position:relative;min-height:590px;display:grid;align-items:center;grid-template-columns:minmax(0,1.1fr) minmax(280px,.9fr);gap:40px;padding:70px 0 84px}.hero-copy{position:relative;z-index:2;max-width:760px}.eyebrow{display:inline-block;margin:0 0 18px;color:var(--color-signal);font:600 13px var(--font-mono)}.hero h1{max-width:720px;margin:0;font-size:var(--step-5);line-height:.98;letter-spacing:-.055em}.lede{max-width:650px;margin:24px 0 28px;color:var(--color-ink-dim);font-size:clamp(16px,1.8vw,19px);line-height:1.72}.actions{display:flex;gap:8px;flex-wrap:wrap}.primary,.secondary{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 16px;border-radius:var(--radius-md);font-size:13px;font-weight:600;transition:transform var(--duration-base) var(--ease-out),color var(--duration-base) var(--ease-out),background var(--duration-base) var(--ease-out),border-color var(--duration-base) var(--ease-out)}.primary{background:var(--color-ink);color:var(--color-bg)}.primary:hover{transform:translateY(-1px)}.secondary{border:1px solid var(--color-border-strong);color:var(--color-ink);background:var(--color-surface)}.secondary:hover{border-color:var(--color-signal);color:var(--color-signal)}.hero-field{position:absolute;inset:30px 0 25px 47%;color:var(--color-signal);border-left:1px solid var(--color-border);overflow:hidden;mask-image:linear-gradient(to right,transparent,black 12%,black 88%,transparent)}.hero-field::before{content:'';position:absolute;inset:0;background-image:linear-gradient(var(--color-border) 1px,transparent 1px),linear-gradient(90deg,var(--color-border) 1px,transparent 1px);background-size:52px 52px;opacity:.35;mask-image:linear-gradient(to right,black,transparent 92%)}#calibration-field{display:block;width:100%;height:100%}.field-caption{position:absolute;right:18px;bottom:16px;padding:4px 6px;background:var(--color-surface);color:var(--color-ink-faint);font:9px var(--font-mono)}.facts{display:grid;grid-template-columns:1fr 1fr 1fr;border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border)}.facts>div{padding:18px 16px;border-right:1px solid var(--color-border)}.facts>div:last-child{border-right:0}.facts span{display:block;color:var(--color-ink-faint);font:10px var(--font-mono);margin-bottom:8px}.facts strong{display:block;color:var(--color-ink);font-size:13px;line-height:1.55;font-weight:500}.section-block{padding-top:92px}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:17px}.section-kicker{color:var(--color-ink-faint);font:11px var(--font-mono)}.section-heading h2{margin:6px 0 0;font-size:var(--step-3);letter-spacing:-.035em}.text-link{color:var(--color-signal);font-size:12px}.project-list{border-top:1px solid var(--color-border)}.project-row{display:grid;grid-template-columns:50px minmax(0,1fr) 28px;align-items:center;gap:18px;padding:22px 2px;border-bottom:1px solid var(--color-border);transition:padding-left var(--duration-base) var(--ease-out),background var(--duration-base) var(--ease-out)}.project-row:hover{padding-left:10px;background:color-mix(in srgb,var(--color-signal-dim) 40%,transparent)}.project-index{color:var(--color-ink-faint);font:11px var(--font-mono)}.tag{display:inline-block;padding:4px 6px;border:1px solid var(--color-border);border-radius:var(--radius-md);color:var(--color-signal);background:var(--color-surface);font:9px var(--font-mono)}.project-row h3{margin:8px 0 4px;font-size:21px;letter-spacing:-.025em}.project-row p{max-width:700px;margin:0;color:var(--color-ink-dim);font-size:13px;line-height:1.6}.project-arrow{justify-self:end;color:var(--color-signal)}.method-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border)}.method-grid article{padding:20px 16px 22px;border-right:1px solid var(--color-border)}.method-grid article:last-child{border-right:0}.method-grid span{color:var(--color-signal);font:11px var(--font-mono)}.method-grid h3{margin:18px 0 7px;font-size:20px;letter-spacing:-.025em}.method-grid p{margin:0;color:var(--color-ink-dim);font-size:13px;line-height:1.65}.closing{display:flex;justify-content:space-between;align-items:end;gap:30px;padding:84px 0 0}.closing h2{margin:7px 0;color:var(--color-ink);font-size:var(--step-3);letter-spacing:-.035em}.closing p{max-width:650px;margin:0;color:var(--color-ink-dim);font-size:13px;line-height:1.7}.closing .primary{flex:0 0 auto}@media(max-width:850px){.hero{grid-template-columns:1fr;min-height:560px}.hero-field{left:28%;inset:35px 0 25px 28%;opacity:.75}.facts,.method-grid{grid-template-columns:1fr}.facts>div,.method-grid article{border-right:0;border-bottom:1px solid var(--color-border)}.facts>div:last-child,.method-grid article:last-child{border-bottom:0}.closing{align-items:flex-start;flex-direction:column}.closing .primary{width:100%}}@media(max-width:560px){.hero{min-height:610px;padding-top:48px}.hero h1{font-size:clamp(2.65rem,12vw,4rem)}.lede{font-size:16px}.hero-field{left:0;top:250px;border-left:0;opacity:.55}.project-row{grid-template-columns:28px 1fr 18px;gap:12px}.project-row h3{font-size:18px}.project-row p{font-size:12px}}
</style>
