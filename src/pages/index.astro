---
import Layout from '../layouts/Layout.astro';
const projects = [
  {num:'01', title:'Finger Gesture Cursor Control', category:'Computer Vision', metric:'40 FPS / <25ms', description:'Real-time hand tracking mapped to cursor interaction, designed to run locally without GPU dependency.'},
  {num:'02', title:'ESP32 IoT Device Simulator', category:'Edge & IoT', metric:'1s telemetry', description:'A virtual edge-device environment for testing MQTT telemetry, sensor data, and dashboard flows.'},
  {num:'03', title:'Robo Soccer · NSECT-2026', category:'Robotics', metric:'<15ms loop', description:'Wireless differential-drive robot with a browser-based multi-touch control interface.'},
];
---
<Layout>
  <section class="hero">
    <div class="hero-copy">
      <div class="eyebrow"><span class="pulse"></span> AI / ML · SYSTEMS · ROBOTICS</div>
      <p class="overline">KAUSHAL KUMAR · MATHEMATICS &amp; COMPUTING</p>
      <h1>I build technical systems that <em>work in the real world.</em></h1>
      <p class="lede">I am a B.Tech Mathematics &amp; Computing student focused on practical AI, computer vision, edge systems, robotics, and measurable engineering. I like turning ideas into working prototypes, then improving them through experiments and constraints.</p>
      <div class="actions"><a class="primary" href="/projects/">Explore selected work <span>↗</span></a><a class="secondary" href="/contact/">Start a conversation</a></div>
    </div>
    <aside class="hero-aside">
      <div class="identity-card">
        <div class="card-label"><span>PROFILE</span><span>CUJ · 2025 / 2029</span></div>
        <div class="profile-line"><span class="avatar">K</span><div><strong>Kaushal Kumar</strong><span>Builder &amp; technical mentor</span></div></div>
        <div class="mini-rule"></div>
        <dl><div><dt>Focus</dt><dd>AI systems</dd></div><div><dt>Base</dt><dd>India</dd></div><div><dt>Mode</dt><dd>Learning + building</dd></div></dl>
      </div>
      <div class="quote-card"><span class="quote-mark">“</span><p>Measure the system, understand the constraint, then make it better.</p><small>Working principle</small></div>
    </aside>
  </section>

  <section class="proof" aria-label="Selected proof points">
    <div><span class="proof-value">74.07%</span><span class="proof-label">CNN test accuracy · CIFAR-10</span></div>
    <div><span class="proof-value">40 FPS</span><span class="proof-label">Gesture control throughput</span></div>
    <div><span class="proof-value">&lt;25ms</span><span class="proof-label">Vision control latency</span></div>
    <div><span class="proof-value">10+</span><span class="proof-label">Teams mentored</span></div>
  </section>

  <section class="feature-section">
    <div class="section-heading"><div><span class="section-index">01 / ENGINEERING SIGNAL</span><h2>Proof before adjectives.</h2></div><p>Selected evidence from projects, experiments, and applied work.</p></div>
    <div class="feature-grid">
      <article class="terminal panel">
        <div class="terminal-head"><span class="window-dot"></span><span class="window-dot"></span><span class="window-dot"></span><span class="terminal-title">gesture-control / runtime</span><span class="live">LIVE TRACE</span></div>
        <div class="terminal-body">
          <div class="terminal-row"><span>$ start vision-engine</span><b>ok</b></div>
          <div class="terminal-row"><span>camera pipeline</span><b>online</b></div>
          <div class="terminal-row"><span>hand landmarks</span><b>21</b></div>
          <div class="terminal-row"><span>tracking state</span><b>stable</b></div>
          <div class="terminal-row"><span>latency</span><b>18ms</b></div>
          <div class="terminal-row"><span>throughput</span><b>40 FPS</b></div>
          <div class="terminal-row"><span>GPU dependency</span><b>none</b></div>
          <div class="terminal-divider"></div>
          <div class="terminal-hint"><span>PINCH</span> left click <span>PEACE</span> scroll <span>FIST</span> freeze</div>
        </div>
      </article>
      <article class="signal panel">
        <span class="section-index">HOW I WORK</span>
        <h3>From problem to prototype.</h3>
        <div class="workflow"><div><span>01</span><strong>Frame</strong><p>Define the problem, inputs, constraints, and success metric.</p></div><div><span>02</span><strong>Build</strong><p>Create the smallest working system that can be measured.</p></div><div><span>03</span><strong>Improve</strong><p>Profile behavior, remove bottlenecks, and document the result.</p></div></div>
      </article>
    </div>
  </section>

  <section class="work-section">
    <div class="section-heading"><div><span class="section-index">02 / SELECTED WORK</span><h2>Systems I have built.</h2></div><a class="text-link" href="/projects/">View full project archive ↗</a></div>
    <div class="project-list">{projects.map((p)=><a class="project-row" href="/projects/"><span class="project-num">{p.num}</span><div class="project-main"><span class="tag">{p.category}</span><h3>{p.title}</h3><p>{p.description}</p></div><span class="project-metric">{p.metric}</span><span class="project-arrow">↗</span></a>)}</div>
  </section>

  <section class="closing panel">
    <div><span class="section-index">03 / NEXT CONVERSATION</span><h2>Have a system worth exploring?</h2><p>Research idea, engineering opportunity, collaboration, or a difficult technical problem. I am interested in useful work with a measurable outcome.</p></div>
    <a class="primary" href="/contact/">Get in touch <span>→</span></a>
  </section>
</Layout>

<style>
.hero{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(280px,.6fr);gap:70px;align-items:end;padding:48px 0 70px}.hero-copy{max-width:850px}.eyebrow{display:inline-flex;align-items:center;gap:8px;padding:7px 10px;border:1px solid rgba(94,230,178,.16);border-radius:999px;background:rgba(94,230,178,.035);color:#9bdbc4;font:9px 'JetBrains Mono';letter-spacing:.1em}.pulse{width:6px;height:6px;border-radius:50%;background:var(--mint);box-shadow:0 0 12px rgba(94,230,178,.8)}.overline,.section-index{font:10px 'JetBrains Mono';color:var(--blue);letter-spacing:.08em}.overline{margin:28px 0 15px;color:#5f6c7d}.hero h1{max-width:860px;margin:0;font-size:clamp(48px,7.5vw,92px);line-height:.96;letter-spacing:-.065em}.hero h1 em{font-style:normal;color:#c6f6fb}.lede{max-width:730px;margin:24px 0 28px;color:#96a2b3;font-size:16px;line-height:1.85}.actions{display:flex;gap:9px;flex-wrap:wrap}.primary,.secondary{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:12px 15px;border-radius:10px;font-size:12px;font-weight:600;transition:transform .2s,background .2s,border-color .2s}.primary{background:#f5f7fa;color:#07090e}.primary:hover{transform:translateY(-2px)}.secondary{border:1px solid var(--line-strong);background:rgba(255,255,255,.025);color:#c5cfdb}.secondary:hover{border-color:rgba(124,236,255,.28);background:rgba(124,236,255,.04)}.hero-aside{display:grid;gap:10px}.panel,.identity-card,.quote-card,.project-row{border:1px solid var(--line);background:var(--panel);backdrop-filter:blur(15px);border-radius:17px}.identity-card{padding:17px}.card-label{display:flex;justify-content:space-between;gap:12px;color:#5f6d80;font:9px 'JetBrains Mono'}.profile-line{display:flex;align-items:center;gap:12px;margin:24px 0 16px}.avatar{display:grid;place-items:center;width:42px;height:42px;border-radius:12px;border:1px solid rgba(124,236,255,.28);background:linear-gradient(135deg,rgba(124,236,255,.12),rgba(124,236,255,.025));font:600 15px 'JetBrains Mono';color:#c8f7fc}.profile-line strong,.profile-line span{display:block}.profile-line strong{font-size:14px;letter-spacing:-.02em}.profile-line span{margin-top:3px;color:#778397;font-size:11px}.mini-rule{height:1px;background:var(--line);margin-bottom:12px}.identity-card dl{margin:0;display:grid;gap:8px}.identity-card dl div{display:flex;justify-content:space-between;gap:14px}.identity-card dt{color:#617084;font:9px 'JetBrains Mono'}.identity-card dd{margin:0;color:#ccd5e0;font-size:11px}.quote-card{padding:18px 18px 17px}.quote-mark{display:block;color:#65dceb;font:30px Georgia;line-height:.6}.quote-card p{margin:13px 0 10px;color:#b9c5d4;font-size:13px;line-height:1.65}.quote-card small{color:#5f6d80;font:9px 'JetBrains Mono'}.proof{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin:0}.proof>div{padding:19px 17px;border-right:1px solid var(--line)}.proof>div:last-child{border-right:0}.proof-value{display:block;font:600 23px 'JetBrains Mono';letter-spacing:-.04em;color:#edf4fa}.proof-label{display:block;margin-top:6px;color:#68778b;font-size:10px;line-height:1.4}.feature-section,.work-section{padding-top:92px}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:18px}.section-heading h2{margin:8px 0 0;font-size:30px;letter-spacing:-.04em}.section-heading>p{max-width:340px;margin:0;color:#728096;font-size:12px;line-height:1.6}.text-link{color:#bfeff4;font-size:11px}.feature-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:12px}.terminal{overflow:hidden;background:#090d13}.terminal-head{display:flex;align-items:center;gap:6px;padding:11px 13px;border-bottom:1px solid var(--line);color:#5f6c7e;font:9px 'JetBrains Mono'}.window-dot{width:6px;height:6px;border-radius:50%;background:#263041}.terminal-title{margin-left:5px}.live{margin-left:auto;color:#62dcae}.terminal-body{padding:20px 18px;font:11px/1.7 'JetBrains Mono'}.terminal-row{display:grid;grid-template-columns:1fr auto;gap:18px;padding:4px 0;color:#8f9caf}.terminal-row:first-child span{color:#b9c6d6}.terminal-row b{font-weight:500;color:#b8f7df}.terminal-divider{height:1px;background:var(--line);margin:12px 0}.terminal-hint{color:#667488}.terminal-hint span{color:#6ee7b7}.signal{padding:20px 21px}.signal h3{margin:11px 0 20px;font-size:23px;letter-spacing:-.03em}.workflow{display:grid;gap:16px}.workflow>div{display:grid;grid-template-columns:34px 1fr;column-gap:9px}.workflow>div>span{grid-row:span 2;color:#57bbff;font:10px 'JetBrains Mono'}.workflow strong{font-size:12px}.workflow p{margin:4px 0 0;color:#7f8da0;font-size:11px;line-height:1.55}.project-list{display:grid;gap:8px}.project-row{display:grid;grid-template-columns:42px minmax(0,1fr) 130px 25px;align-items:center;gap:18px;padding:17px;transition:transform .2s,border-color .2s,background .2s}.project-row:hover{transform:translateX(4px);border-color:rgba(124,236,255,.23);background:rgba(124,236,255,.035)}.project-num{color:#4d5a6d;font:10px 'JetBrains Mono'}.tag{display:inline-block;padding:4px 6px;border-radius:6px;border:1px solid rgba(88,182,255,.15);background:rgba(88,182,255,.035);color:#78cafb;font:9px 'JetBrains Mono'}.project-main h3{margin:9px 0 5px;font-size:17px;letter-spacing:-.025em}.project-main p{margin:0;color:#78869a;font-size:11px;line-height:1.5}.project-metric{justify-self:end;color:#c3f4fb;font:10px 'JetBrains Mono';text-align:right}.project-arrow{justify-self:end;color:#54c6e5}.closing{margin-top:92px;padding:26px;display:flex;justify-content:space-between;align-items:center;gap:30px}.closing h2{margin:8px 0;color:#f1f5f9;font-size:27px;letter-spacing:-.035em}.closing p{max-width:650px;margin:0;color:#7d8b9e;font-size:12px;line-height:1.7}@media(max-width:940px){.hero{grid-template-columns:1fr;gap:30px}.hero-aside{grid-template-columns:1fr 1fr}.feature-grid{grid-template-columns:1fr}.project-row{grid-template-columns:35px 1fr 110px 20px}}@media(max-width:680px){.hero{padding-top:28px}.hero h1{font-size:49px}.lede{font-size:14px}.hero-aside{grid-template-columns:1fr}.proof{grid-template-columns:1fr 1fr}.proof>div:nth-child(2){border-right:0}.proof>div:nth-child(-n+2){border-bottom:1px solid var(--line)}.section-heading{align-items:flex-start;flex-direction:column;gap:8px}.project-row{grid-template-columns:26px 1fr 18px}.project-metric{display:none}.closing{align-items:flex-start;flex-direction:column}.closing .primary{width:100%}}
</style>
