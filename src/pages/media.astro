---
import Layout from '../layouts/Layout.astro';

const items = [
  { type: 'Video', title: 'Finger Gesture Cursor Tracking', meta: 'Computer Vision', body: 'Reserved for the project demo once the original recording is added.', asset: '/assets/media/finger-gesture.mp4' },
  { type: 'Video', title: 'Robo Soccer Match Highlights', meta: 'Robotics', body: 'Reserved for field footage and browser-based control demonstration.', asset: '/assets/media/robo-soccer.mp4' },
  { type: 'Video', title: 'ESP32 MQTT Telemetry', meta: 'Edge and IoT', body: 'Reserved for a walkthrough of the simulated device and telemetry flow.', asset: '/assets/media/esp32-mqtt.mp4' },
  { type: 'Photo', title: 'National Seminar on AI for Good Governance', meta: 'Event · New Delhi', body: 'Add the original event photograph when it is ready for publication.', asset: '/assets/media/ai-governance-seminar.jpg' },
  { type: 'Photo', title: 'AI Builders Weekend', meta: 'Workshop · New Delhi', body: 'Add the original workshop photograph when it is ready for publication.', asset: '/assets/media/ai-builders-weekend.jpg' },
  { type: 'Photo', title: 'ESP32 and Sensor Testing', meta: 'Hardware · CUJ', body: 'Add the original hardware photograph when it is ready for publication.', asset: '/assets/media/esp32-testing.jpg' },
];
---
<Layout title="Media | Kaushal Kumar" description="Project demos, hardware work, workshops, and event photography from Kaushal Kumar's technical journey.">
  <header class="page-heading"><p class="eyebrow">Media</p><h1>See the work in context.</h1><p>Hardware, field tests, workshops, and project demonstrations belong here. The page is prepared for original assets and intentionally ships without fabricated media.</p></header>
  <section class="media-grid">
    {items.map((item) => <article class="media-item">
      <div class="media-frame"><span>{item.type}</span><small>Asset path</small><code>{item.asset}</code></div>
      <div class="media-copy"><p class="meta">{item.meta}</p><h2>{item.title}</h2><p>{item.body}</p></div>
    </article>)}
  </section>
</Layout>
<style>
.page-heading{max-width:820px;padding:45px 0 65px}.eyebrow{margin:0 0 14px;color:var(--color-signal);font:12px var(--font-mono)}.page-heading h1{max-width:760px;margin:0;font-size:var(--step-5);line-height:1;letter-spacing:-.055em}.page-heading>p:last-child{max-width:700px;margin:23px 0 0;color:var(--color-ink-dim);font-size:17px;line-height:1.75}.media-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.media-item{border-top:1px solid var(--color-border)}.media-frame{height:220px;display:flex;flex-direction:column;justify-content:space-between;padding:14px;border:1px solid var(--color-border);border-top:0;background:repeating-linear-gradient(135deg,var(--color-surface),var(--color-surface) 12px,var(--color-bg) 12px,var(--color-bg) 13px);color:var(--color-ink-faint);font:10px var(--font-mono)}.media-frame small{margin-top:auto;font-size:9px}.media-frame code{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--color-ink-dim);font:8px var(--font-mono)}.media-copy{padding-top:15px}.meta{margin:0;color:var(--color-ink-faint);font:10px var(--font-mono)}.media-copy h2{margin:7px 0 0;font-size:19px;line-height:1.25;letter-spacing:-.025em}.media-copy>p:last-child{margin:9px 0 0;color:var(--color-ink-dim);font-size:12px;line-height:1.65}@media(max-width:900px){.media-grid{grid-template-columns:1fr 1fr}}@media(max-width:620px){.media-grid{grid-template-columns:1fr}.page-heading{padding-top:28px}}
</style>
