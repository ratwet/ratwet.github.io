---
import Layout from '../layouts/Layout.astro';
const items = [
  {type:'VIDEO', title:'Finger Gesture Real-Time Cursor Tracking', meta:'Computer Vision · 0:45', body:'Demo slot reserved for the latency test: live hand tracking, gesture classification, and Wayland cursor response.'},
  {type:'VIDEO', title:'Robo Soccer Match Highlights & Wireless Control', meta:'Robotics · 1:20', body:'Demo slot for field testing the 4-wheel differential drive and browser multi-touch controller.'},
  {type:'VIDEO', title:'ESP32 MQTT HiveMQ Live Data Stream', meta:'IoT · 0:30', body:'Demo slot for Wokwi telemetry flowing through MQTT to the OLED and dashboard.'},
  {type:'PHOTO', title:'National Seminar on AI for Good Governance', meta:'Seminars · DAIC, New Delhi', body:'Event gallery slot. Add the optimized image to /public/assets/photos when the original photo is available.'},
  {type:'PHOTO', title:'AI Builders Weekend with Microsoft Leadership', meta:"Workshop · Masters' Union", body:'Workshop gallery slot for the Python AI-agent build session.'},
  {type:'PHOTO', title:'ESP32 & Sensor Testing Setup', meta:'Hardware · CUJ', body:'Hardware gallery slot for breadboard, OLED, and telemetry prototyping.'},
];
---
<Layout title="Media — Kaushal Kumar"><div class="page-intro"><span class="mono">04 / media</span><h1>Proof lives in the demo.</h1><p>A dedicated space for project videos, hardware builds, workshop moments, and event photography.</p></div><div class="notice"><span class="tag mint">MEDIA MANIFEST READY</span><p>The site is intentionally shipping without fabricated video IDs or invented photos. Drop real assets into the documented paths and these cards can become live players/lightboxes without changing the page architecture.</p></div><section class="media-grid">{items.map(item=><article class="media-card"><div class="thumb"><span>{item.type}</span><b>+</b></div><div class="copy"><span class="meta">{item.meta}</span><h2>{item.title}</h2><p>{item.body}</p></div></article>)}</section></Layout>
<style>
.page-intro{max-width:780px;padding:40px 0 55px}.mono,.meta{font:12px 'JetBrains Mono';color:#38bdf8}.page-intro h1{font-size:clamp(42px,6vw,70px);line-height:1;letter-spacing:-.055em;margin:14px 0}.page-intro p,.copy p{color:#93a1b5;line-height:1.75}.notice{display:flex;align-items:center;gap:16px;padding:14px 16px;border:1px solid rgba(16,185,129,.14);background:rgba(16,185,129,.04);border-radius:14px;margin-bottom:18px}.notice p{margin:0;color:#91a29f;font-size:12px;line-height:1.6}.tag.mint{font:10px 'JetBrains Mono';white-space:nowrap;color:#6ee7b7;padding:5px 7px;border:1px solid rgba(16,185,129,.18);border-radius:7px}.media-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.media-card{overflow:hidden;border:1px solid var(--line);background:rgba(15,23,42,.54);border-radius:16px}.thumb{height:150px;display:flex;align-items:center;justify-content:space-between;padding:16px;background:linear-gradient(135deg,rgba(56,189,248,.11),rgba(16,185,129,.04));font:10px 'JetBrains Mono';color:#7dd3fc}.thumb b{font-size:42px;font-weight:300;color:rgba(255,255,255,.22)}.copy{padding:17px}.copy h2{font-size:18px;line-height:1.2;letter-spacing:-.02em;margin:9px 0}.copy p{font-size:12px;margin-bottom:3px}@media(max-width:900px){.media-grid{grid-template-columns:1fr 1fr}}@media(max-width:600px){.media-grid{grid-template-columns:1fr}.notice{align-items:flex-start;flex-direction:column}}
</style>
